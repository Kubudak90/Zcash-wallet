\ No newline at end of file
+# Threads (wasm_thread, wasm-bindgen-rayon) need atomics and one shared, imported linear
+# memory. rustc up to the 2025-01 nightly WebZjs pinned derived the linker flags below from
+# `+atomics` by itself; the 2026-10 nightly no longer does, and without them the module gets
+# an ordinary, unshared memory (wasm-bindgen then emits no threaded init, and workers cannot
+# share the heap). They are the flags rustc used to pass, as the wasm-bindgen-rayon README
+# lists them: shared + imported memory, 1 GiB maximum, and the TLS exports wasm-bindgen's
+# thread transform uses.
+rustflags = [
+  "-C", "target-feature=+atomics,+bulk-memory,+mutable-globals",
+  "-C", "link-arg=--shared-memory",
+  "-C", "link-arg=--import-memory",
+  "-C", "link-arg=--max-memory=1073741824",
+  "-C", "link-arg=--export=__wasm_init_tls",
+  "-C", "link-arg=--export=__tls_size",
+  "-C", "link-arg=--export=__tls_align",
+  "-C", "link-arg=--export=__tls_base",
+  # Also no longer exported by default; wasm-bindgen 0.2.100's thread transform needs
+  # `__heap_base` ("failed to find `__heap_base` for injecting thread id").
+  "-C", "link-arg=--export=__heap_base",
+  "-C", "link-arg=--export=__data_end",
+  "--cfg", "getrandom_backend=\"wasm_js\"",
+]
