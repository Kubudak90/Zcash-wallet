+//! Lock-free progress counters for a running sync pass.
+//!
+//! `Wallet::sync` holds the database write lock for the whole pass, so every reader
+//! (`get_wallet_summary`, `get_transaction_history`, ...) waits until the pass ends and
+//! the UI cannot show progress. The sync loop in `zcash_client_backend::sync::run` has no
+//! progress callback, but it drives its block cache in a fixed order per batch:
+//! `insert` (download done) -> `with_blocks` twice (trial decryption, then note tracking)
+//! -> `delete` (lazy, awaited at the end of the pass). Wrapping the cache lets us count
+//! blocks as they move through those steps, with atomics any thread may read without
+//! touching the wallet database lock.
+
+use std::sync::atomic::{AtomicBool, AtomicU32, Ordering::Relaxed};
+use std::sync::Arc;
+
+use async_trait::async_trait;
+use zcash_client_backend::data_api::chain::{error::Error as ChainError, BlockCache, BlockSource};
+use zcash_client_backend::data_api::scanning::ScanRange;
+use zcash_client_backend::proto::compact_formats::CompactBlock;
+use zcash_protocol::consensus::BlockHeight;
+
+/// Counters for the current (or most recent) sync pass. All methods are lock-free.
+#[derive(Debug, Default)]
+pub struct SyncCounters {
+    running: AtomicBool,
+    /// Compact blocks downloaded into the block cache during this pass.
+    downloaded: AtomicU32,
+    /// Blocks handed to the scanner so far (each block counted once, on its first visit).
+    visited: AtomicU32,
+    /// Blocks seen again on the scanner's second walk of a batch (note tracking, after
+    /// trial decryption); diagnostic, to see where a batch spends its time.
+    revisited: AtomicU32,
+    /// Blocks whose batch has been scanned and committed to the wallet database.
+    scanned: AtomicU32,
+    /// Highest block height visited during this pass (0 if none yet).
+    scanned_to: AtomicU32,
+    /// Highest height visited since the last batch download. `scan_cached_blocks` walks
+    /// each batch twice, so a block only counts when it exceeds this.
+    batch_max: AtomicU32,
+}
+
+/// A copy of the counters at one instant.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct SyncSnapshot {
+    pub running: bool,
+    pub downloaded: u32,
+    pub visited: u32,
+    pub revisited: u32,
+    pub scanned: u32,
+    pub scanned_to: u32,
+}
+
+impl SyncCounters {
+    /// Called when a pass starts: clears the counters of the previous pass.
+    pub fn start(&self) {
+        self.downloaded.store(0, Relaxed);
+        self.visited.store(0, Relaxed);
+        self.revisited.store(0, Relaxed);
+        self.scanned.store(0, Relaxed);
+        self.scanned_to.store(0, Relaxed);
+        self.batch_max.store(0, Relaxed);
+        self.running.store(true, Relaxed);
+    }
+
+    /// Called when a pass ends (with or without error).
+    pub fn finish(&self) {
+        // Every downloaded batch has been scanned by the time `run` returns.
+        self.scanned.store(self.downloaded.load(Relaxed), Relaxed);
+        self.running.store(false, Relaxed);
+    }
+
+    fn on_insert(&self, blocks: &[CompactBlock]) {
+        // `sync::run` is sequential: the previous batch was scanned and committed before
+        // this one was fetched, so everything downloaded so far is now scanned.
+        self.scanned.store(self.downloaded.load(Relaxed), Relaxed);
+        self.downloaded.fetch_add(blocks.len() as u32, Relaxed);
+        let first = blocks.iter().map(|b| u32::from(b.height())).min().unwrap_or(0);
+        self.batch_max.store(first.saturating_sub(1), Relaxed);
+    }
+
+    fn on_block(&self, height: BlockHeight) {
+        let h = u32::from(height);
+        if h > self.batch_max.load(Relaxed) {
+            self.batch_max.store(h, Relaxed);
+            self.visited.fetch_add(1, Relaxed);
+            self.scanned_to.fetch_max(h, Relaxed);
+        } else {
+            self.revisited.fetch_add(1, Relaxed);
+        }
+    }
+
+    pub fn snapshot(&self) -> SyncSnapshot {
+        SyncSnapshot {
+            running: self.running.load(Relaxed),
+            downloaded: self.downloaded.load(Relaxed),
+            visited: self.visited.load(Relaxed),
+            revisited: self.revisited.load(Relaxed),
+            scanned: self.scanned.load(Relaxed),
+            scanned_to: self.scanned_to.load(Relaxed),
+        }
+    }
+}
+
+/// A `BlockCache` that forwards to another cache and reports progress to `SyncCounters`.
+pub struct ProgressCache<C> {
+    inner: C,
+    counters: Arc<SyncCounters>,
+}
+
+impl<C> ProgressCache<C> {
+    pub fn new(inner: C, counters: Arc<SyncCounters>) -> Self {
+        Self { inner, counters }
+    }
+}
+
+impl<C: BlockSource> BlockSource for ProgressCache<C> {
+    type Error = C::Error;
+
+    fn with_blocks<F, WalletErrT>(
+        &self,
+        from_height: Option<BlockHeight>,
+        limit: Option<usize>,
+        mut with_block: F,
+    ) -> Result<(), ChainError<WalletErrT, Self::Error>>
+    where
+        F: FnMut(CompactBlock) -> Result<(), ChainError<WalletErrT, Self::Error>>,
+    {
+        self.inner.with_blocks(from_height, limit, |block| {
+            let height = block.height();
+            with_block(block)?;
+            self.counters.on_block(height);
+            Ok(())
+        })
+    }
+}
+
+#[async_trait]
+impl<C> BlockCache for ProgressCache<C>
+where
+    C: BlockCache,
+    C::Error: Send,
+{
+    fn get_tip_height(&self, range: Option<&ScanRange>) -> Result<Option<BlockHeight>, Self::Error> {
+        self.inner.get_tip_height(range)
+    }
+
+    async fn read(&self, range: &ScanRange) -> Result<Vec<CompactBlock>, Self::Error> {
+        self.inner.read(range).await
+    }
+
+    async fn insert(&self, compact_blocks: Vec<CompactBlock>) -> Result<(), Self::Error> {
+        // Runs when `download_blocks` awaits it, right after the batch arrived.
+        self.counters.on_insert(&compact_blocks);
+        self.inner.insert(compact_blocks).await
+    }
+
+    async fn delete(&self, range: ScanRange) -> Result<(), Self::Error> {
+        // `run` collects these futures and awaits them at the end of the pass, so this
+        // body is not a usable per-batch hook; `insert` and `with_blocks` are.
+        self.inner.delete(range).await
+    }
+}
