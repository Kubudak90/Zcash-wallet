+/// Encodes `text` as a ZIP 302 text memo (at most 512 bytes). A Rust string is UTF-8, and
+/// UTF-8 text never starts with a byte above 0xF4, so the bytes read back as a text memo.
+pub fn text_memo(text: &str) -> Result<MemoBytes, Error> {
+    MemoBytes::from_bytes(text.as_bytes()).map_err(|_| Error::MemoTooLong(text.len()))
+}
