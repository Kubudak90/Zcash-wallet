diff --git a/crates/webzjs-wallet/src/pass_budget.rs b/crates/webzjs-wallet/src/pass_budget.rs
new file mode 100644
index 0000000..d071ffe
--- /dev/null
+++ b/crates/webzjs-wallet/src/pass_budget.rs
@@ -0,0 +1,454 @@
+//! Limits of one sync pass: its length (review finding R3) and the bytes of one batch of
+//! compact blocks (verifier finding M1).
+//!
+//! **Time.** `zcash_client_backend::sync::run` scans until the wallet is at the chain tip, and
+//! Celari saves the wallet only when a pass returns. A restore of months of blocks is one pass of
+//! tens of minutes: closing the tab, a crash or an out-of-memory loses all of it. A pass with a
+//! budget ends at the first batch download after the budget ran out (and always after at least
+//! one batch): `run` downloads a batch only once the previous batch is scanned and committed,
+//! so refusing that download ends the pass with every scanned batch committed, the same state
+//! as a pass cut short by a network error, which the next pass continues from. The refusal
+//! happens in the transport (`BudgetedTransport`) before `GetBlockRange` goes out, so no block
+//! is downloaded for nothing.
+//!
+//! **Bytes.** `run` downloads a whole batch (`batch_size` blocks) into memory before scanning
+//! it. Compact blocks of the 2022-2023 spam era are up to ~100 kB each (MEASURED: 96,980 B per
+//! block at 1,750,000, against ~1.5 kB today), so a batch of 10,000 of them is about 1 GB and
+//! the wasm module, whose memory cannot exceed 1 GiB, traps: such a restore could never finish.
+//! The transport counts the bytes of each `GetBlockRange` answer:
+//! - after a batch, it works out how many blocks of that size fit in [`BatchBytes::target`] and,
+//!   if that differs from the batch size in use by a factor of two or more, refuses the next
+//!   `GetBlockRange` (as the time budget does); the pass then calls `run` again with the new
+//!   batch size, within the same pass and budget;
+//! - a batch whose answer grows beyond [`BatchBytes::max`] is abandoned while it downloads (the
+//!   answer ends with an error, so `run` stores nothing of it and returns), and the pass goes on
+//!   with batches sized from the bytes per block seen so far, at most half the size. A batch of
+//!   [`BatchBytes::min_blocks`] is never abandoned, so a pass always makes progress.
+//!
+//! Both refusals leave the wallet as a network error after a committed batch does. Restarting
+//! `run` costs its preamble (subtree roots, chain tip, transparent outputs, scan ranges): a few
+//! requests, and only when the size of the blocks changes.
+
+use std::pin::Pin;
+use std::sync::atomic::{AtomicBool, AtomicU32, AtomicU64, Ordering::Relaxed};
+use std::sync::Arc;
+use std::task::{Context, Poll};
+
+use futures_util::future::{self, Either, Ready};
+use http_body::Frame;
+use tonic::client::GrpcService;
+use tonic::codegen::{http, Body, Bytes, Service, StdError};
+use tonic::{Code, Status};
+
+/// The status message of the download refused at the end of the time budget (code `Cancelled`).
+pub const BUDGET_REACHED: &str = "celari: sync pass budget reached";
+
+/// The status message of the download refused, or abandoned, to change the batch size (code
+/// `Cancelled`).
+pub const BATCH_RESIZE: &str = "celari: sync batch size changed";
+
+/// The gRPC path of the batch download `sync::run` makes once per batch.
+const GET_BLOCK_RANGE: &str = "/cash.z.wallet.sdk.rpc.CompactTxStreamer/GetBlockRange";
+
+/// How many bytes of compact blocks (as they arrive: gRPC frames) one batch may hold.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct BatchBytes {
+    /// The batch size aims at this many bytes.
+    pub target: u64,
+    /// A batch download that grows beyond this is abandoned (unless it is `min_blocks`).
+    pub max: u64,
+    /// The smallest batch, never abandoned whatever its size.
+    pub min_blocks: u32,
+}
+
+impl Default for BatchBytes {
+    /// 32 MiB per batch, abandoned beyond 64 MiB, at least 20 blocks. In the browser a batch
+    /// takes about 2.4 times its download size in wasm memory while it is decoded and scanned
+    /// (MEASURED: a 10,000-block batch of ~12 kB blocks raised the wasm high-water mark by 287
+    /// MiB), so a batch stays near 80 MiB and at most ~150 MiB, next to a wallet state of a few
+    /// hundred MiB. Twenty blocks of the largest possible compact blocks (a 2 MB block holds
+    /// fewer than 2 MB of outputs) are under 40 MB.
+    fn default() -> Self {
+        Self { target: 32 << 20, max: 64 << 20, min_blocks: 20 }
+    }
+}
+
+/// The limits of one sync pass: time and batch bytes. Shared by the pass and its transport.
+#[derive(Clone, Debug)]
+pub struct PassBudget {
+    inner: Arc<Inner>,
+}
+
+#[derive(Debug)]
+struct Inner {
+    started_ms: f64,
+    /// `None`: no budget, the pass runs to the chain tip.
+    budget_ms: Option<f64>,
+    /// `GetBlockRange` calls let through.
+    batches: AtomicU32,
+    reached: AtomicBool,
+    bytes: BatchBytes,
+    /// The largest batch (the wallet's `batch_size`).
+    max_blocks: u32,
+    /// The batch size `run` is running with.
+    batch_blocks: AtomicU32,
+    /// A batch size to restart `run` with (0: none); while set, `GetBlockRange` is refused.
+    resize_to: AtomicU32,
+    /// Bytes of the largest `GetBlockRange` answer received in this pass (abandoned ones
+    /// included, up to where they were abandoned).
+    largest_batch_bytes: AtomicU64,
+    /// Batch downloads abandoned for their size.
+    abandoned: AtomicU32,
+    /// Restarts of `run` with another batch size.
+    resizes: AtomicU32,
+}
+
+impl PassBudget {
+    /// A budget of `budget_ms` milliseconds from now (`None`: unlimited), batches of at most
+    /// `max_blocks` blocks and `bytes`, starting with batches of `start_blocks` blocks.
+    pub fn new(budget_ms: Option<u64>, bytes: BatchBytes, max_blocks: u32, start_blocks: u32) -> Self {
+        let max_blocks = max_blocks.max(1);
+        let min = bytes.min_blocks.clamp(1, max_blocks);
+        Self {
+            inner: Arc::new(Inner {
+                started_ms: now_ms(),
+                budget_ms: budget_ms.map(|ms| ms as f64),
+                batches: AtomicU32::new(0),
+                reached: AtomicBool::new(false),
+                bytes: BatchBytes { min_blocks: min, ..bytes },
+                max_blocks,
+                batch_blocks: AtomicU32::new(start_blocks.clamp(min, max_blocks)),
+                resize_to: AtomicU32::new(0),
+                largest_batch_bytes: AtomicU64::new(0),
+                abandoned: AtomicU32::new(0),
+                resizes: AtomicU32::new(0),
+            }),
+        }
+    }
+
+    /// Whether the budget ended the pass (a batch download was refused).
+    pub fn reached(&self) -> bool {
+        self.inner.reached.load(Relaxed)
+    }
+
+    /// The batches downloaded in the pass so far.
+    pub fn batches(&self) -> u32 {
+        self.inner.batches.load(Relaxed)
+    }
+
+    /// Whether `status` is this budget's refusal rather than an error of the server.
+    pub fn is_refusal(&self, status: &Status) -> bool {
+        self.reached() && status.code() == Code::Cancelled && status.message() == BUDGET_REACHED
+    }
+
+    /// Whether `status` ended `run` to change the batch size (see [`Self::start_run`]).
+    pub fn is_resize(&self, status: &Status) -> bool {
+        self.inner.resize_to.load(Relaxed) != 0 && status.code() == Code::Cancelled && status.message() == BATCH_RESIZE
+    }
+
+    /// The batch size for the next call of `run`, taking up a pending resize.
+    pub fn start_run(&self) -> u32 {
+        let to = self.inner.resize_to.swap(0, Relaxed);
+        if to != 0 {
+            self.inner.batch_blocks.store(to, Relaxed);
+            self.inner.resizes.fetch_add(1, Relaxed);
+        }
+        self.inner.batch_blocks.load(Relaxed)
+    }
+
+    /// The batch size to start the next pass with: the one in use, or a pending resize.
+    pub fn next_pass_blocks(&self) -> u32 {
+        match self.inner.resize_to.load(Relaxed) {
+            0 => self.inner.batch_blocks.load(Relaxed),
+            to => to,
+        }
+    }
+
+    /// Bytes of the largest batch answer of the pass so far.
+    pub fn largest_batch_bytes(&self) -> u64 {
+        self.inner.largest_batch_bytes.load(Relaxed)
+    }
+
+    /// Batch downloads abandoned for their size, and restarts of `run` with another size.
+    pub fn resize_counts(&self) -> (u32, u32) {
+        (self.inner.abandoned.load(Relaxed), self.inner.resizes.load(Relaxed))
+    }
+
+    /// Lets a request through, or refuses it (a batch download only): to change the batch size,
+    /// or after at least one batch once the time budget has run out.
+    fn admits(&self, path: &str) -> Result<(), &'static str> {
+        if path != GET_BLOCK_RANGE {
+            return Ok(());
+        }
+        if let Some(budget_ms) = self.inner.budget_ms {
+            if self.inner.batches.load(Relaxed) >= 1 && now_ms() - self.inner.started_ms >= budget_ms {
+                self.inner.reached.store(true, Relaxed);
+                return Err(BUDGET_REACHED);
+            }
+        }
+        if self.inner.resize_to.load(Relaxed) != 0 {
+            return Err(BATCH_RESIZE);
+        }
+        self.inner.batches.fetch_add(1, Relaxed);
+        Ok(())
+    }
+
+    /// The batch size that puts `target` bytes in a batch of blocks of `bytes / blocks` bytes.
+    fn blocks_for(&self, bytes: u64, blocks: u32) -> u32 {
+        let BatchBytes { target, min_blocks, .. } = self.inner.bytes;
+        let fit = if bytes == 0 { u64::MAX } else { target.saturating_mul(u64::from(blocks.max(1))) / bytes };
+        fit.clamp(u64::from(min_blocks), u64::from(self.inner.max_blocks)) as u32
+    }
+
+    /// A batch answer of `bytes` bytes and `blocks` blocks arrived in full: change the batch
+    /// size for the following batches if blocks of this size call for one half or twice the size
+    /// or more. Only a full batch can make it grow: a short one (the end of a range, such as the
+    /// few new blocks at the tip a pass scans first) says little about the next range, and
+    /// growing on it made every pass of a spam-era restore abandon its first batch (MEASURED).
+    fn batch_received(&self, bytes: u64, blocks: u32) {
+        if blocks == 0 {
+            return;
+        }
+        let current = self.inner.batch_blocks.load(Relaxed);
+        let want = self.blocks_for(bytes, blocks);
+        let grow = blocks >= current && want >= current.saturating_mul(2);
+        if want.saturating_mul(2) <= current || grow {
+            tracing::info!(
+                "sync batch of {blocks} blocks was {bytes} bytes: batch size {current} -> {want} blocks"
+            );
+            self.inner.resize_to.store(want, Relaxed);
+        }
+    }
+
+    /// A batch answer has reached `bytes` bytes with `blocks` blocks complete. Returns the
+    /// refusal that abandons it if it is over the limit and the batch can still shrink.
+    fn batch_growing(&self, bytes: u64, blocks: u32) -> Option<Status> {
+        self.inner.largest_batch_bytes.fetch_max(bytes, Relaxed);
+        let current = self.inner.batch_blocks.load(Relaxed);
+        if bytes <= self.inner.bytes.max || current <= self.inner.bytes.min_blocks {
+            return None;
+        }
+        let want = self.blocks_for(bytes, blocks).min(current / 2).max(self.inner.bytes.min_blocks);
+        tracing::warn!(
+            "sync batch of {current} blocks passed {bytes} bytes after {blocks} blocks: abandoned, \
+             continuing with batches of {want} blocks"
+        );
+        self.inner.abandoned.fetch_add(1, Relaxed);
+        self.inner.resize_to.store(want, Relaxed);
+        Some(Status::cancelled(BATCH_RESIZE))
+    }
+}
+
+/// Counts the gRPC messages (length-prefixed frames: a flag byte, a 4-byte big-endian length,
+/// the message) in a stream of data chunks.
+#[derive(Debug, Default)]
+pub(crate) struct FrameCounter {
+    header: [u8; 5],
+    header_len: usize,
+    /// Bytes of the current message still to come.
+    remaining: u64,
+    /// Complete messages.
+    pub(crate) messages: u32,
+    /// All data bytes seen.
+    pub(crate) bytes: u64,
+    /// A frame that is not a message (a gRPC-web trailer frame in the data) stops the count.
+    stopped: bool,
+}
+
+impl FrameCounter {
+    pub(crate) fn feed(&mut self, mut data: &[u8]) {
+        self.bytes += data.len() as u64;
+        while !data.is_empty() && !self.stopped {
+            if self.remaining > 0 {
+                let n = (self.remaining.min(data.len() as u64)) as usize;
+                self.remaining -= n as u64;
+                data = &data[n..];
+                if self.remaining == 0 {
+                    self.messages += 1;
+                }
+                continue;
+            }
+            let n = (5 - self.header_len).min(data.len());
+            self.header[self.header_len..self.header_len + n].copy_from_slice(&data[..n]);
+            self.header_len += n;
+            data = &data[n..];
+            if self.header_len == 5 {
+                self.header_len = 0;
+                if self.header[0] & 0x80 != 0 {
+                    self.stopped = true;
+                    break;
+                }
+                let len = u32::from_be_bytes([self.header[1], self.header[2], self.header[3], self.header[4]]);
+                if len == 0 {
+                    self.messages += 1;
+                } else {
+                    self.remaining = u64::from(len);
+                }
+            }
+        }
+    }
+}
+
+/// The answer body of a request through `BudgetedTransport`: for `GetBlockRange`, counts the
+/// batch's bytes and blocks, and ends with an error once it is too large (`PassBudget`).
+pub struct CountedBody<B> {
+    inner: Pin<Box<B>>,
+    /// `Some` for a batch download.
+    batch: Option<(PassBudget, FrameCounter)>,
+    /// The batch answer was received in full and counted.
+    counted: bool,
+    /// The batch answer was abandoned for its size: nothing more of it is read.
+    abandoned: bool,
+}
+
+impl<B> CountedBody<B> {
+    /// The end of the batch answer (its trailers, or the end of the body): counted once.
+    fn received(&mut self) {
+        if self.counted || self.abandoned {
+            return;
+        }
+        self.counted = true;
+        if let Some((budget, counter)) = &self.batch {
+            budget.inner.largest_batch_bytes.fetch_max(counter.bytes, Relaxed);
+            budget.batch_received(counter.bytes, counter.messages);
+        }
+    }
+}
+
+impl<B> Body for CountedBody<B>
+where
+    B: Body<Data = Bytes>,
+    B::Error: Into<StdError>,
+{
+    type Data = Bytes;
+    type Error = StdError;
+
+    fn poll_frame(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Option<Result<Frame<Bytes>, StdError>>> {
+        let this = &mut *self;
+        if this.abandoned {
+            return Poll::Ready(Some(Err(Box::new(Status::cancelled(BATCH_RESIZE)))));
+        }
+        let frame = match this.inner.as_mut().poll_frame(cx) {
+            Poll::Pending => return Poll::Pending,
+            Poll::Ready(None) => {
+                this.received();
+                return Poll::Ready(None);
+            }
+            Poll::Ready(Some(Err(e))) => return Poll::Ready(Some(Err(e.into()))),
+            Poll::Ready(Some(Ok(frame))) => frame,
+        };
+        if let Some((budget, counter)) = &mut this.batch {
+            if let Some(data) = frame.data_ref() {
+                counter.feed(data);
+                if let Some(refusal) = budget.batch_growing(counter.bytes, counter.messages) {
+                    this.abandoned = true;
+                    return Poll::Ready(Some(Err(Box::new(refusal))));
+                }
+            } else if frame.is_trailers() {
+                this.received();
+            }
+        }
+        Poll::Ready(Some(Ok(frame)))
+    }
+
+    fn is_end_stream(&self) -> bool {
+        self.abandoned || self.inner.is_end_stream()
+    }
+
+    fn size_hint(&self) -> http_body::SizeHint {
+        self.inner.size_hint()
+    }
+}
+
+/// The answer future of a request through `BudgetedTransport`.
+pub struct CountedFuture<F> {
+    inner: Pin<Box<F>>,
+    batch: Option<PassBudget>,
+}
+
+impl<F, B, E> std::future::Future for CountedFuture<F>
+where
+    F: std::future::Future<Output = Result<http::Response<B>, E>>,
+    E: Into<StdError>,
+{
+    type Output = Result<http::Response<CountedBody<B>>, StdError>;
+
+    fn poll(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Self::Output> {
+        let this = &mut *self;
+        match this.inner.as_mut().poll(cx) {
+            Poll::Pending => Poll::Pending,
+            Poll::Ready(result) => {
+                let batch = this.batch.take();
+                Poll::Ready(result.map_err(into_std).map(|response| {
+                    response.map(|body| CountedBody {
+                        inner: Box::pin(body),
+                        batch: batch.map(|b| (b, FrameCounter::default())),
+                        counted: false,
+                        abandoned: false,
+                    })
+                }))
+            }
+        }
+    }
+}
+
+/// A gRPC transport that applies a `PassBudget` to the batch downloads of a pass and forwards
+/// everything to `inner`.
+#[derive(Clone, Debug)]
+pub struct BudgetedTransport<T> {
+    inner: T,
+    budget: PassBudget,
+}
+
+impl<T> BudgetedTransport<T> {
+    pub fn new(inner: T, budget: PassBudget) -> Self {
+        Self { inner, budget }
+    }
+}
+
+fn into_std<E: Into<StdError>>(e: E) -> StdError {
+    e.into()
+}
+
+impl<T> Service<http::Request<tonic::body::Body>> for BudgetedTransport<T>
+where
+    T: GrpcService<tonic::body::Body>,
+    T::Error: Into<StdError>,
+{
+    type Response = http::Response<CountedBody<T::ResponseBody>>;
+    type Error = StdError;
+    type Future = Either<CountedFuture<T::Future>, Ready<Result<Self::Response, StdError>>>;
+
+    fn poll_ready(&mut self, cx: &mut Context<'_>) -> Poll<Result<(), Self::Error>> {
+        GrpcService::poll_ready(&mut self.inner, cx).map_err(into_std)
+    }
+
+    fn call(&mut self, request: http::Request<tonic::body::Body>) -> Self::Future {
+        let is_batch = request.uri().path() == GET_BLOCK_RANGE;
+        if let Err(refusal) = self.budget.admits(request.uri().path()) {
+            // tonic hands a `Status` from the transport back to the caller unchanged.
+            let refusal: StdError = Box::new(Status::cancelled(refusal));
+            return Either::Right(future::ready(Err(refusal)));
+        }
+        Either::Left(CountedFuture {
+            inner: Box::pin(GrpcService::call(&mut self.inner, request)),
+            batch: is_batch.then(|| self.budget.clone()),
+        })
+    }
+}
+
+/// Milliseconds since the Unix epoch: the JavaScript clock on wasm32
+/// (`std::time::SystemTime::now` panics there), the system clock elsewhere.
+fn now_ms() -> f64 {
+    #[cfg(target_arch = "wasm32")]
+    {
+        js_sys::Date::now()
+    }
+    #[cfg(not(target_arch = "wasm32"))]
+    {
+        std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .map(|d| d.as_secs_f64() * 1000.0)
+            .unwrap_or(0.0)
+    }
+}
