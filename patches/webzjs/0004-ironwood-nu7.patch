+// The app's own signing and proving path (webzjs-keys
+// `pczt_sign_inner`, `Wallet::pczt_prove`), and a mock node that refuses a transaction whose
+// consensus branch is not its next block's (`MockLwd::node_branch_check`), as a mempool does.
+
+const SEED: [u8; 32] = [7u8; 32];
+
+/// What Celari's WebzjsEngine.signProveSend does before `pczt_send`: webzjs-keys' `pczt_sign`
+/// (every Orchard, Ironwood, Sapling and transparent spend of this seed), then `pczt_prove`.
+async fn app_sign_prove(wallet: &W, pczt: pczt::Pczt, usk: &UnifiedSpendingKey) -> pczt::Pczt {
+    let fp = zip32::fingerprint::SeedFingerprint::from_seed(&SEED).unwrap();
+    let signed = webzjs_keys::pczt_sign_inner(Network::MainNetwork, pczt, usk.clone(), fp)
+        .await
+        .unwrap_or_else(|e| panic!("pczt_sign: {e:?}"));
+    wallet.pczt_prove(signed, None).await.unwrap_or_else(|e| panic!("pczt_prove: {e:?}"))
+}
+
+fn sent_tx(mock: &MockLwd, i: usize) -> zcash_primitives::transaction::Transaction {
+    let raw = mock.0.lock().unwrap().sent[i].clone();
+    zcash_primitives::transaction::Transaction::read(&raw[..], BranchId::Nu7).unwrap()
+}
