@@ -0,0 +1,149 @@
+//! The fresh shielded-only address binding, the current address, and R7's transparent pending
+//! value.
+
+use transparent::address::Script;
+use transparent::bundle::{OutPoint, TxOut};
+use zcash_client_backend::data_api::wallet::ConfirmationsPolicy;
+use zcash_client_backend::data_api::{Account as _, WalletRead, WalletWrite};
+use zcash_client_backend::wallet::WalletTransparentOutput;
+use zcash_keys::address::Address;
+use zcash_keys::keys::UnifiedAddressRequest;
+use zcash_protocol::value::Zatoshis;
+
+use super::boundary::mainnet_wallet;
+use super::mock_lwd::{mainnet, MockLwd};
+
+#[tokio::test]
+async fn next_shielded_address_is_fresh_shielded_only_and_recorded() {
+    let mock = MockLwd::new(mainnet::LAST);
+    let (wallet, account) = mainnet_wallet(&mock, Some(mainnet::LAST));
+    let current = wallet.current_address(account).await.unwrap().unwrap();
+    assert!(current.transparent().is_some() && current.orchard().is_some() && current.sapling().is_some());
+
+    let a = wallet.next_shielded_address(account).await.unwrap();
+    let b = wallet.next_shielded_address(account).await.unwrap();
+    for ua in [&a, &b] {
+        assert!(ua.orchard().is_some(), "an Orchard receiver (Ironwood funds arrive at it)");
+        assert!(ua.sapling().is_some(), "a Sapling receiver");
+        assert!(ua.transparent().is_none(), "no transparent receiver");
+    }
+    assert_ne!(a, b, "a fresh address each time");
+    assert_ne!(a, current);
+
+    // `get_current_address` still answers the full address. (Asking with ALLOW_ALL, as the
+    // binding did, would now answer the newest shielded-only one, whose missing transparent
+    // receiver `get_current_address_transparent` cannot report.)
+    assert_eq!(wallet.current_address(account).await.unwrap().unwrap(), current);
+    let newest = wallet.db.read().await.get_last_generated_address_matching(account, UnifiedAddressRequest::ALLOW_ALL).unwrap().unwrap();
+    assert_eq!(newest, b);
+
+    // Recorded: the wallet attributes the addresses to the account, also after a save and load.
+    let bytes = wallet.db_to_bytes().await.unwrap();
+    let loaded = zcash_client_memory::MemoryWalletDb::decode_new(&bytes, webzjs_common::Network::MainNetwork, crate::PRUNING_DEPTH).unwrap();
+    for ua in [&a, &b] {
+        let address = Address::Unified(Box::new(ua.clone()));
+        assert_eq!(
+            loaded.find_account_for_address(&webzjs_common::Network::MainNetwork, &address).ok().flatten(),
+            Some(account)
+        );
+    }
+}
+
+/// Right after the account is added (no sync yet), the backend knows a chain tip from the
+/// account's scan queue (as zcash_client_sqlite: the end of the queued range), so a fresh
+/// address is available at once (exposed at that height).
+#[tokio::test]
+async fn next_shielded_address_works_before_the_first_sync() {
+    let mock = MockLwd::new(mainnet::LAST);
+    let (wallet, account) = mainnet_wallet(&mock, None);
+    let ua = wallet.next_shielded_address(account).await.unwrap();
+    assert!(ua.orchard().is_some() && ua.sapling().is_some() && ua.transparent().is_none());
+    assert_eq!(mock.calls().len(), 0, "no network");
+}
+
+/// Review finding R7: transparent value at too few confirmations is reported next to the
+/// spendable value (before, the binding had no field for it: not shown anywhere).
+#[tokio::test]
+async fn transparent_pending_value() {
+    // The backend gives a summary once blocks are scanned: sync the captured blocks first.
+    let mock = MockLwd::new(mainnet::LAST).with_mainnet_data();
+    let (wallet, account) = mainnet_wallet(&mock, None);
+    wallet.sync().await.unwrap();
+    let taddr = {
+        let db = wallet.db.read().await;
+        db.get_account(account).unwrap().unwrap().uivk().default_transparent_address().unwrap().0
+    };
+    let utxo = |n: u8, value: u64, height: u32| {
+        WalletTransparentOutput::from_parts(
+            OutPoint::new([n; 32], 0),
+            TxOut::new(Zatoshis::const_from_u64(value), Script::from(taddr.script())),
+            Some(zcash_protocol::consensus::BlockHeight::from_u32(height)),
+            Some(account),
+            None,
+            None,
+        )
+        .unwrap()
+    };
+    {
+        let mut db = wallet.db.write().await;
+        db.put_received_transparent_utxo(&utxo(1, 50_000, mainnet::LAST - 20)).unwrap();
+        db.put_received_transparent_utxo(&utxo(2, 70_000, mainnet::LAST)).unwrap();
+    }
+    // 10 confirmations, and no zero-conf shielding (which would make every UTXO spendable).
+    let policy = ConfirmationsPolicy::new_symmetrical(std::num::NonZeroU32::new(10).unwrap(), false);
+    let summary = wallet.db.read().await.get_wallet_summary(policy).unwrap().unwrap();
+    let balance = summary.account_balances().get(&account).unwrap();
+    assert_eq!(u64::from(balance.unshielded_balance().spendable_value()), 50_000);
+    assert_eq!(crate::wallet::unshielded_pending(balance), 70_000, "the 1-confirmation output is pending");
+    assert_eq!(u64::from(balance.unshielded_balance().total()), 120_000);
+}
+
+/// Funds sent to any address `next_shielded_address` handed out are the account's, an older
+/// one included after newer ones were handed out: the Receive screen promises that earlier
+/// addresses keep working. Ironwood notes to the Orchard receivers of two fresh addresses (the
+/// older paid last) and a Sapling note to the older one's Sapling receiver are all received,
+/// with the request the binding uses.
+#[test]
+fn earlier_shielded_addresses_keep_receiving() {
+    use zcash_client_backend::data_api::testing::{
+        orchard::OrchardPoolTester, pool::ShieldedPoolTester, sapling::SaplingPoolTester, AddressType, IronwoodFvk,
+    };
+
+    use super::fixtures::{ironwood_network, seed_wallet};
+
+    let (mut st, account, usk, _, _) = seed_wallet(ironwood_network(None));
+    // A scanned block first, so the backend knows a chain tip to expose the addresses at (in
+    // the app the account's scan queue gives it one, see the test above).
+    let (h0, _) = st.generate_empty_block();
+    st.scan_cached_blocks(h0, 1);
+    let uivk = st.wallet().get_account(account).unwrap().unwrap().uivk();
+    let request = crate::wallet::shielded_only_request(&uivk).unwrap();
+    let (older, older_j) = st.wallet_mut().get_next_available_address(account, request).unwrap().unwrap();
+    let (newer, newer_j) = st.wallet_mut().get_next_available_address(account, request).unwrap().unwrap();
+    assert_ne!(older, newer);
+    assert!(older.transparent().is_none() && newer.transparent().is_none());
+
+    // The test outputs go to exactly the receivers that were handed out.
+    let orchard_fvk = OrchardPoolTester::sk_to_fvk(OrchardPoolTester::usk_to_sk(&usk));
+    let sapling_fvk = SaplingPoolTester::sk_to_fvk(SaplingPoolTester::usk_to_sk(&usk));
+    let external = ::orchard::keys::Scope::External;
+    assert_eq!(orchard_fvk.address_at(older_j, external), *older.orchard().unwrap());
+    assert_eq!(orchard_fvk.address_at(newer_j, external), *newer.orchard().unwrap());
+    assert_eq!(sapling_fvk.address(older_j), Some(*older.sapling().unwrap()));
+
+    let iw = IronwoodFvk(orchard_fvk);
+    let (h, _, _) = st.generate_next_block(&iw, AddressType::DiversifiedExternal(newer_j), Zatoshis::const_from_u64(200_000));
+    st.generate_next_block(&iw, AddressType::DiversifiedExternal(older_j), Zatoshis::const_from_u64(300_000));
+    st.generate_next_block(&sapling_fvk, AddressType::DiversifiedExternal(older_j), Zatoshis::const_from_u64(400_000));
+    st.scan_cached_blocks(h, 3);
+
+    let summary = st.wallet().get_wallet_summary(ConfirmationsPolicy::MIN).unwrap().unwrap();
+    let balance = summary.account_balances().get(&account).unwrap();
+    assert_eq!(u64::from(balance.ironwood_balance().total()), 500_000, "both Orchard receivers received Ironwood notes");
+    assert_eq!(u64::from(balance.sapling_balance().total()), 400_000, "the older address's Sapling receiver received");
+    // And the account still owns both addresses.
+    for ua in [&older, &newer] {
+        let address = Address::Unified(Box::new(ua.clone()));
+        assert_eq!(st.wallet().find_account_for_address(st.network(), &address).ok().flatten(), Some(account));
+    }
+}
