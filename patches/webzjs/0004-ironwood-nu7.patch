+/// A mainnet wallet (real tree state at 3,533,399 as its birthday) whose view of the chain tip
+/// is `wallet_tip`, talking to `mock`.
+pub(crate) fn mainnet_wallet(
+    mock: &MockLwd,
+    wallet_tip: Option<u32>,
+) -> (Wallet<MemoryWalletDb<Network>, MockLwd>, zcash_client_memory::AccountId) {
+    let tree = TreeState::decode(&grpcweb_messages(mainnet::TREESTATES[0].1)[0][..]).unwrap();
+    let mut db = MemoryWalletDb::new(Network::MainNetwork, crate::PRUNING_DEPTH);
+    let birthday = AccountBirthday::from_treestate(tree, None).unwrap();
+    let (account, _) = db.create_account("a", &SecretVec::new(vec![7u8; 32]), &birthday, None).unwrap();
+    if let Some(tip) = wallet_tip {
+        db.update_chain_tip(h(tip)).unwrap();
+    }
+    (Wallet::new(db, mock.clone(), Network::MainNetwork, ConfirmationsPolicy::MIN).unwrap(), account)
+}
