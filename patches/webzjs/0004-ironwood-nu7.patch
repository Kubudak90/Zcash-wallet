+    assert_eq!(tip(&wallet).await, 3_543_407, "synced first");
+    let proved = app_sign_prove(&wallet, pczt, &c.usk).await;
+    let sent = wallet.pczt_send(proved).await;
+    let tx = sent_tx(&mock, 0);
+    println!(
+        "v2 send pipeline: {sent:?}; tx {} version {:?} branch {:?} expiry {}",
+        tx.txid(),
+        tx.version(),
+        tx.consensus_branch_id(),
+        u32::from(tx.expiry_height())
+    );
+    sent.expect("accepted by a node whose next block is NU7's");
+    assert_eq!(tx.consensus_branch_id(), BranchId::Nu7);
+    assert_eq!(u32::from(tx.consensus_branch_id()), NU7_BRANCH);
+    assert!(u32::from(tx.expiry_height()) > NU7);
+}
