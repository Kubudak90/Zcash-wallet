+/// gRPC frames split anywhere between data chunks are counted as whole messages.
+#[test]
+fn frame_counter_counts_messages_across_chunks() {
+    use crate::pass_budget::FrameCounter;
+    let mut stream = vec![];
+    for len in [3usize, 0, 70_000, 1] {
+        stream.push(0u8);
+        stream.extend_from_slice(&(len as u32).to_be_bytes());
+        stream.extend(std::iter::repeat_n(7u8, len));
+    }
+    for chunk in [1usize, 2, 4, 5, 7, 1000, stream.len()] {
+        let mut c = FrameCounter::default();
+        for part in stream.chunks(chunk) {
+            c.feed(part);
+        }
+        assert_eq!((c.messages, c.bytes), (4, stream.len() as u64), "chunks of {chunk}");
+    }
+    // A gRPC-web trailer frame in the data ends the count.
+    let mut c = FrameCounter::default();
+    c.feed(&[0, 0, 0, 0, 1, 9, 0x80, 0, 0, 0, 2, 1, 2]);
+    assert_eq!(c.messages, 1);
+}
+
+/// Verifier finding M1: a batch is bounded by the bytes of its compact blocks, not only by
+/// their number. Spam-era blocks (2022-2023) are up to ~100 kB, so 10,000 of them were ~1 GB in
+/// one download, beyond the wasm memory maximum: the engine trapped and a restore over that range
+/// could never finish. Here the 109 captured mainnet blocks (~850 bytes each) stand in, with the
+/// limits scaled down (8 KiB per batch, abandoned beyond 24 KiB) and a batch size of up to 109:
+/// the first batch (109 blocks) is abandoned once its answer passes 24 KiB, the pass goes on with
+/// batches of about 8 KiB, and the wallet ends at the tip with every block scanned once, the
+/// same wallet as one pass in a single 109-block batch.
+#[tokio::test]
+async fn batches_follow_the_bytes_of_the_blocks() {
+    use crate::pass_budget::BatchBytes;
+    let blocks = mainnet::LAST - mainnet::FIRST + 1;
+    let max_block_frame = grpcweb_message_sizes().into_iter().max().unwrap() as u64 + 5;
+
+    // One batch of 109 blocks, no byte limit.
+    let mock = MockLwd::new(mainnet::LAST).with_mainnet_data().with_all_tree_states();
+    let (mut whole, _) = mainnet_wallet(&mock, None);
+    whole.batch_size = blocks;
+    whole.next_batch_blocks.store(blocks, Relaxed);
+    whole.batch_bytes = BatchBytes { target: u64::MAX / 4, max: u64::MAX / 2, min_blocks: 1 };
+    whole.set_sync_pass_ms(0);
+    whole.sync().await.unwrap();
+    assert_eq!(mock.count("GetBlockRange"), 1);
+
+    let mock = MockLwd::new(mainnet::LAST).with_mainnet_data().with_all_tree_states();
+    let (mut wallet, _) = mainnet_wallet(&mock, None);
+    wallet.batch_size = blocks;
+    wallet.next_batch_blocks.store(blocks, Relaxed);
+    let limits = BatchBytes { target: 8 * 1024, max: 24 * 1024, min_blocks: 2 };
+    wallet.batch_bytes = limits;
+    wallet.set_sync_pass_ms(0);
+    wallet.sync().await.unwrap();
+    let p = wallet.sync_progress();
+    let ranges: Vec<String> = mock.calls().into_iter().filter(|c| c.starts_with("GetBlockRange")).collect();
+    eprintln!("progress {p:?}; batch downloads {ranges:?}");
+    assert!(
+        p.largest_batch_bytes as u64 <= limits.max + max_block_frame,
+        "no batch answer was read beyond the limit: {} bytes",
+        p.largest_batch_bytes
+    );
+    assert!(p.batches_abandoned >= 1, "the first 109-block batch was abandoned");
+    assert!(ranges.len() >= 6, "the range was scanned in batches of about 8 KiB: {ranges:?}");
+    assert!(p.batch_blocks < blocks / 4, "the pass ended with small batches: {}", p.batch_blocks);
+    assert_eq!((p.downloaded, p.visited), (blocks, blocks), "every block downloaded and scanned once");
+    assert_eq!(p.ironwood_actions, 382);
+    assert!(!p.ended_early);
+    let scanned = |w: &crate::Wallet<zcash_client_memory::MemoryWalletDb<webzjs_common::Network>, MockLwd>| {
+        futures_util::FutureExt::now_or_never(w.db.read()).unwrap().block_fully_scanned().unwrap().map(|m| u32::from(m.block_height()))
+    };
+    assert_eq!(scanned(&wallet), Some(mainnet::LAST));
+    // The same wallet as one batch: note commitment tree roots, blocks, scan ranges, summary.
+    // (Not byte for byte: scanning checkpoints the last block of every batch in every tree, as
+    // upstream does for any batch size, so the checkpoint sets differ.)
+    let ((a, roots_a), (b, roots_b)) = (wallet_state(&whole).await, wallet_state(&wallet).await);
+    assert!(a == b, "the small batches leave the same wallet as one batch:\n{a}\n{b}");
+    let mut common = [0; 3];
+    for (h, (x, y)) in (mainnet::FIRST..).zip(roots_a.iter().zip(&roots_b)) {
+        for pool in 0..3 {
+            if let (Some(x), Some(y)) = (&x[pool], &y[pool]) {
+                assert_eq!(x, y, "tree {pool} root at {h}");
+                common[pool] += 1;
+            }
+        }
+    }
+    eprintln!("tree roots compared at {common:?} common checkpoints");
+    assert!(common.iter().all(|c| *c >= 3), "{common:?}");
+    // The next pass starts with the batch size this one ended with: its last batch, a single
+    // block at the tip, was short, so it does not make the size grow.
+    assert_eq!(wallet.next_batch_blocks.load(Relaxed), p.batch_blocks);
+}
+
+/// What a wallet synced over the captured blocks knows, apart from where its trees have
+/// checkpoints: summary, scan ranges, chain tip, blocks, transactions, each tree's last leaf
+/// (as text), and each tree's root at every height, `None` where it has no checkpoint.
+async fn wallet_state(
+    w: &crate::Wallet<zcash_client_memory::MemoryWalletDb<webzjs_common::Network>, MockLwd>,
+) -> (String, Vec<[Option<String>; 3]>) {
+    use zcash_client_backend::data_api::wallet::ConfirmationsPolicy;
+    use zcash_client_backend::data_api::WalletCommitmentTrees;
+    let mut db = w.db.write().await;
+    let mut roots = vec![];
+    for h in mainnet::FIRST..=mainnet::LAST {
+        let h = BlockHeight::from(h);
+        roots.push([
+            db.with_sapling_tree_mut(|t| t.root_at_checkpoint_id(&h)).unwrap().map(|r| format!("{r:?}")),
+            db.with_orchard_tree_mut(|t| t.root_at_checkpoint_id(&h)).unwrap().map(|r| format!("{r:?}")),
+            db.with_ironwood_tree_mut(|t| t.root_at_checkpoint_id(&h)).unwrap().flatten().map(|r| format!("{r:?}")),
+        ]);
+    }
+    let leaves = (
+        db.with_sapling_tree_mut(|t| t.max_leaf_position(None)).unwrap(),
+        db.with_orchard_tree_mut(|t| t.max_leaf_position(None)).unwrap(),
+        db.with_ironwood_tree_mut(|t| t.max_leaf_position(None)).unwrap(),
+    );
+    let blocks: Vec<_> = (mainnet::FIRST..=mainnet::LAST).map(|h| db.block_metadata(h.into()).unwrap()).collect();
+    let state = format!(
+        "leaves {leaves:?}\nsummary {:?}\nranges {:?}\ntip {:?}\nblocks {blocks:?}\ntxs {}",
+        db.get_wallet_summary(ConfirmationsPolicy::MIN).unwrap(),
+        db.suggest_scan_ranges().unwrap(),
+        db.chain_height().unwrap(),
+        db.tx_table().iter().count()
+    );
+    (state, roots)
+}
+
+/// The sizes of the captured compact blocks' gRPC messages.
+fn grpcweb_message_sizes() -> Vec<usize> {
+    super::mock_lwd::grpcweb_messages(mainnet::BLOCKS).iter().map(|m| m.len()).collect()
+}
+
+/// Verifier finding M3 (export): `db_to_bytes` returns a buffer of exactly the wallet's size.
+/// Grown by doubling, the export of an 80 MiB wallet held up to 128 MiB, briefly 192 MiB while
+/// the last doubling copied, and the binding's `into_boxed_slice` then copied once more to drop
+/// the spare capacity: wasm memory never shrinks, so that peak stayed for the session.
+#[tokio::test]
+async fn the_export_is_sized_exactly() {
+    let mock = MockLwd::new(mainnet::LAST).with_mainnet_data();
+    let (wallet, _) = mainnet_wallet(&mock, None);
+    wallet.set_sync_pass_ms(0);
+    wallet.sync().await.unwrap();
+    let bytes = wallet.db_to_bytes().await.unwrap();
+    eprintln!("export: {} bytes, capacity {}", bytes.len(), bytes.capacity());
+    assert_eq!(bytes.capacity(), bytes.len(), "no spare capacity");
+    // The same bytes as an encode into a growing buffer.
+    let mut grown = vec![];
