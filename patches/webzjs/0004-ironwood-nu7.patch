+    c.empty_to(3_543_400, true);
+    c.empty_to(3_543_407, false);
+    let mock = MockLwd::new(3_543_407);
+    mock.0.lock().unwrap().node_branch_check = true;
+    c.serve(&mock, 3_543_407);
