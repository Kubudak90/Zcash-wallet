+/// Signs every spend of the account's own notes in `pczt` (as webzjs-keys' `pczt_sign`) and
+/// makes its Orchard and Ironwood proofs (as `Wallet::pczt_prove`).
+pub(crate) fn sign_and_prove(pczt: pczt::Pczt, usk: &zcash_keys::keys::UnifiedSpendingKey) -> pczt::Pczt {
+    let ask = orchard::keys::SpendAuthorizingKey::from(usk.orchard());
+    // The account's own spends carry a ZIP 32 derivation (dummy spends do not, and the IO
+    // finalizer signed them), found as webzjs-keys' `pczt_sign` finds them.
+    let own = |bundle: &orchard::pczt::Bundle| -> Vec<usize> {
+        bundle
+            .actions()
+            .iter()
+            .enumerate()
+            .filter(|(_, a)| a.spend().zip32_derivation().is_some())
+            .map(|(i, _)| i)
+            .collect()
+    };
+    let (mut own_orchard, mut own_ironwood) = (vec![], vec![]);
+    let pczt = pczt::roles::verifier::Verifier::new(pczt)
+        .with_orchard::<Infallible, _>(|bundle| {
+            own_orchard = own(bundle);
+            Ok(())
+        })
+        .unwrap()
+        .with_ironwood::<Infallible, _>(|bundle| {
+            own_ironwood = own(bundle);
+            Ok(())
+        })
+        .unwrap()
+        .finish();
+    assert!(!own_orchard.is_empty() || !own_ironwood.is_empty(), "the PCZT spends the account's notes");
+    let mut rng = secure_rng().unwrap();
+    let mut signer = pczt::roles::signer::Signer::new(pczt).unwrap();
+    for i in own_orchard {
+        signer.sign_orchard(&mut rng, i, &ask).unwrap();
+    }
+    for i in own_ironwood {
+        signer.sign_ironwood(&mut rng, i, &ask).unwrap();
+    }
+    let pczt = signer.finish();
+    let branch = *pczt.global().consensus_branch_id();
+    let pk = orchard::circuit::ProvingKey::build(orchard_circuit_version(branch).unwrap());
+    let mut prover = pczt::roles::prover::Prover::new(pczt);
+    if prover.requires_orchard_proof() {
+        prover = prover.create_orchard_proof(&mut rng, &pk).unwrap();
+    }
+    if prover.requires_ironwood_proof() {
+        prover = prover.create_ironwood_proof(&mut rng, &pk).unwrap();
+    }
+    assert!(!prover.requires_sapling_proofs());
+    prover.finish()
+}
+
+/// End to end with a real PCZT: built (and signed, proven) for the block before NU7, sent once
+/// NU7 is active. `extract_and_store_minable_pczt` (what `pczt_send` now calls) refuses it and
+/// stores nothing; the unchecked extraction the old `pczt_send` did stores it, marking the note
+/// spent by a transaction that can never be mined. A PCZT built in the new epoch goes through.
+#[test]
+fn a_real_old_epoch_pczt_is_not_stored_once_nu7_is_active() {
+    const NU7_OFFSET: u32 = 20;
+    let network = ironwood_network(Some(NU7_OFFSET));
+    let nu7 = network.activation_height(NetworkUpgrade::Nu7).unwrap();
+    let (mut st, account, usk, _, _) = seed_wallet(network);
+    let fvk = OrchardPoolTester::sk_to_fvk(OrchardPoolTester::usk_to_sk(&usk));
+    let value = Zatoshis::const_from_u64(500_000);
+    let (h0, _, _) = st.generate_next_block(&fvk, AddressType::DefaultExternal, value);
+    st.scan_cached_blocks(h0, 1);
+    // Up to the block two below NU7, so the next PCZT targets the last NU6.3 block.
+    while st.wallet().chain_height().unwrap().unwrap() + 2 < nu7 {
+        let (hh, _) = st.generate_empty_block();
+        st.scan_cached_blocks(hh, 1);
+    }
+
+    let build = |st: &mut St| {
+        let to = OrchardPoolTester::sk_default_address(&OrchardPoolTester::sk(&[0xf5; 32]));
+        let request = TransactionRequest::new(vec![Payment::without_memo(
+            to.to_zcash_address(st.network()),
+            Zatoshis::const_from_u64(100_000),
+        )])
+        .unwrap();
+        let proposal = st
+            .propose_transfer(account, &GreedyInputSelector::new(), &webzjs_change_strategy(), request, ConfirmationsPolicy::MIN)
+            .unwrap();
+        let pczt = st
+            .create_pczt_from_proposal::<Infallible, _, Infallible>(account, OvkPolicy::Sender, &proposal, None)
+            .unwrap();
+        sign_and_prove(pczt, &usk)
+    };
+    let old_epoch = build(&mut st);
+    let target = st.wallet().chain_height().unwrap().unwrap() + 1;
+    assert_eq!(target + 1, nu7);
+    assert_eq!(u32::from(BranchId::for_height(st.network(), target)), *old_epoch.global().consensus_branch_id());
+    assert_eq!(*old_epoch.global().consensus_branch_id(), NU6_3_BRANCH);
+
+    // NU7 activates before the PCZT is sent.
+    for _ in 0..3 {
+        let (hh, _) = st.generate_empty_block();
+        st.scan_cached_blocks(hh, 1);
+    }
+    let tip = st.wallet().chain_height().unwrap().unwrap();
+    assert!(tip >= nu7);
+    let txs_before = st.wallet().tx_table().iter().count();
+    let balance = |st: &St| st.get_total_balance(account);
+    let balance_before = balance(&st);
+
+    let network = st.network().clone();
+    let refused = extract_and_store_minable_pczt(&network, st.wallet_mut(), old_epoch.clone(), tip);
+    assert!(matches!(refused, Err(Error::PcztWrongBranch { pczt_branch: NU6_3_BRANCH, .. })), "{refused:?}");
+    assert_eq!(st.wallet().tx_table().iter().count(), txs_before, "nothing stored");
+    assert_eq!(balance(&st), balance_before);
+
+    // What the old pczt_send did: extract and store without the check. It succeeds, and the
+    // note now counts as spent by a transaction no NU7 block can include.
+    let mut unchecked = MemoryWalletDb::decode_new(&encode(st.wallet()), network, crate::PRUNING_DEPTH).unwrap();
+    let prover = LocalTxProver::bundled();
+    let (spend_vk, output_vk) = prover.verifying_keys();
+    let stored = extract_and_store_transaction_from_pczt::<_, ()>(
+        &mut unchecked,
+        &WebClock,
+        &mut secure_rng().unwrap(),
+        old_epoch,
+        Some((&spend_vk, &output_vk)),
+        None,
+    );
+    let stored_txid = stored.expect("the unchecked path stores the old-epoch transaction");
+    assert!(unchecked.tx_table().get(&stored_txid).is_some());
+    assert_eq!(unchecked.tx_table().iter().count(), txs_before + 1);
+
+    // A PCZT built now, in NU7, is stored.
+    let new_epoch = build(&mut st);
+    assert_eq!(*new_epoch.global().consensus_branch_id(), NU7_BRANCH);
+    let txid = extract_and_store_minable_pczt(&network, st.wallet_mut(), new_epoch, tip).unwrap();
+    assert!(st.wallet().tx_table().get(&txid).is_some());
+}
+
+fn encode(db: &MemoryWalletDb<zcash_protocol::local_consensus::LocalNetwork>) -> Vec<u8> {
+    let mut bytes = vec![];
+    db.encode(&mut bytes).unwrap();
+    bytes
+}
