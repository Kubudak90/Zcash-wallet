@@ -0,0 +1,135 @@
+//! Network upgrade boundaries for transactions this wallet builds and sends (review finding
+//! R1).
+//!
+//! A transaction commits to the consensus branch of the block height it targets (v5 and v6
+//! transactions carry the branch id; it is also part of every signature hash), and it can be
+//! mined only in a block of that branch, at or below its expiry height. The wallet derives the
+//! target height from its own view of the chain tip (`chain_height() + 1`). When that view is
+//! stale across an activation height (the wallet's tip in NU6.3, the network's already in
+//! NU7), the transaction is built for an epoch that has ended and can never be mined; if it is
+//! then stored before broadcasting (`extract_and_store_transaction_from_pczt`), its inputs
+//! count as spent until its expiry height and the history shows a send that never happened.
+//!
+//! The rules here are pure functions of the network parameters and heights, so they are tested
+//! at the real mainnet heights around NU7 (3,543,405).
+
+use zcash_protocol::consensus::{BlockHeight, BranchId, Parameters, UPGRADES_IN_ORDER};
+
+use crate::error::Error;
+
+/// More blocks than this behind the network tip, the wallet syncs before building.
+pub const MAX_BLOCKS_BEHIND_TO_BUILD: u32 = 10;
+
+/// Within this many blocks of a network upgrade's activation height (either side), the wallet
+/// syncs to the network tip before building, however close it is.
+pub const UPGRADE_SYNC_WINDOW: u32 = 20;
+
+/// No transaction is built for, or sent in, the last blocks of an epoch: a transaction for the
+/// old branch that is not mined before the activation height can never be mined, and its
+/// inputs stay locked until it expires (for a ZIP 318 canonical crossing, whose expiry is a
+/// rolling period of about a month, for weeks). Ten blocks is about twelve minutes at 75 s.
+///
+/// The pause also covers the activation block itself (verifier finding NU7-2): a transaction
+/// for the new branch is built and sent only once the network's tip is at or above the
+/// activation height, so a lightwalletd backend one block behind the one that answered
+/// `GetLatestBlock` (several sit behind one URL) also sees the new branch as its next block's.
+pub const UPGRADE_SEND_PAUSE: u32 = 10;
+
+/// zcashd's `TX_EXPIRING_SOON_THRESHOLD`: a transaction whose expiry height is within this
+/// many blocks of the next block is refused by the mempool ("tx-expiring-soon").
+pub const EXPIRING_SOON_THRESHOLD: u32 = 3;
+
+/// Whether the wallet must sync before building a transaction, given its own view of the chain
+/// tip and the tip the network (lightwalletd) reports.
+///
+/// - more than [`MAX_BLOCKS_BEHIND_TO_BUILD`] blocks behind (the old rule: stale anchors and
+///   expiry), or
+/// - the next block after the wallet's tip and the next block after the network's tip are in
+///   different consensus branches (the wallet would build for the wrong epoch), or
+/// - the next block is within [`UPGRADE_SYNC_WINDOW`] blocks of an activation height (the
+///   network tip just read may itself lag by a block or two).
+pub fn must_sync_before_building<P: Parameters>(params: &P, wallet_tip: BlockHeight, network_tip: BlockHeight) -> bool {
+    if network_tip > wallet_tip && u32::from(network_tip) - u32::from(wallet_tip) > MAX_BLOCKS_BEHIND_TO_BUILD {
+        return true;
+    }
+    if BranchId::for_height(params, wallet_tip + 1) != BranchId::for_height(params, network_tip + 1) {
+        return true;
+    }
+    near_activation(params, wallet_tip + 1, UPGRADE_SYNC_WINDOW).is_some()
+}
+
+/// The first activation height within `window` blocks of `height` (either side), if any.
+pub fn near_activation<P: Parameters>(params: &P, height: BlockHeight, window: u32) -> Option<BlockHeight> {
+    UPGRADES_IN_ORDER
+        .iter()
+        .filter_map(|nu| params.activation_height(*nu))
+        .find(|a| u32::from(*a).abs_diff(u32::from(height)) <= window)
+}
+
+/// Refuses to build a transaction targeting `target` if it falls in the last
+/// [`UPGRADE_SEND_PAUSE`] blocks before an activation height or is the activation height
+/// itself (see there); `blocks_left` is then 0.
+pub fn check_build_target<P: Parameters>(params: &P, target: BlockHeight) -> Result<(), Error> {
+    let branch = BranchId::for_height(params, target);
+    if let Some(next) = activation_at_or_above(params, target) {
+        let blocks_left = u32::from(next) - u32::from(target);
+        if blocks_left <= UPGRADE_SEND_PAUSE {
+            return Err(Error::UpgradePending {
+                activation_height: u32::from(next),
+                blocks_left,
+                branch: u32::from(branch),
+            });
+        }
+    }
+    Ok(())
+}
+
+/// The lowest activation height at or above `height`, if one is known.
+fn activation_at_or_above<P: Parameters>(params: &P, height: BlockHeight) -> Option<BlockHeight> {
+    UPGRADES_IN_ORDER
+        .iter()
+        .filter_map(|nu| params.activation_height(*nu))
+        .filter(|a| *a >= height)
+        .min()
+}
+
+/// The activation height of the first network upgrade above `height`, if one is known.
+pub fn next_activation<P: Parameters>(params: &P, height: BlockHeight) -> Option<BlockHeight> {
+    UPGRADES_IN_ORDER
+        .iter()
+        .filter_map(|nu| params.activation_height(*nu))
+        .filter(|a| *a > height)
+        .min()
+}
+
+/// Whether a transaction with this consensus branch id and expiry height can still be mined in
+/// the block after `network_tip`; checked before anything is stored for a PCZT being sent.
+///
+/// Refused: a branch other than the next block's; an expiry height (other than 0, "never")
+/// that the mempool would reject as expired or expiring soon (at or below
+/// `network_tip + EXPIRING_SOON_THRESHOLD`); the old epoch's last [`UPGRADE_SEND_PAUSE`]
+/// blocks, and the activation block itself (the new epoch starts for sending once
+/// `network_tip` is at or above the activation height).
+pub fn check_minable<P: Parameters>(
+    params: &P,
+    consensus_branch_id: u32,
+    expiry_height: u32,
+    network_tip: BlockHeight,
+) -> Result<(), Error> {
+    let next = network_tip + 1;
+    let expected = BranchId::for_height(params, next);
+    if consensus_branch_id != u32::from(expected) {
+        return Err(Error::PcztWrongBranch {
+            pczt_branch: consensus_branch_id,
+            network_branch: u32::from(expected),
+            next_height: u32::from(next),
+        });
+    }
+    if expiry_height != 0 && expiry_height <= u32::from(network_tip) + EXPIRING_SOON_THRESHOLD {
+        return Err(Error::PcztExpired {
+            expiry_height,
+            network_tip: u32::from(network_tip),
+        });
+    }
+    check_build_target(params, next)
+}
diff --git a/crates/webzjs-wallet/src/data_requests.rs b/crates/webzjs-wallet/src/data_requests.rs
new file mode 100644
index 0000000..51b83dc
--- /dev/null
+++ b/crates/webzjs-wallet/src/data_requests.rs
@@ -0,0 +1,329 @@
+//! Serving the wallet's transaction data requests after each sync pass (review finding R4).
+//!
+//! Compact blocks carry no memos, no outgoing outputs and no transparent data. The backend
+//! asks for the rest through `WalletRead::transaction_data_requests` (zcash_client_sqlite's
+//! `tx_retrieval_queue` and transparent spend searches): the full data of every transaction
+//! scanning found the wallet involved in (`Enhancement`), the mined status of transactions it
+//! is waiting for (`GetStatus`), and the transactions that spend its transparent outputs
+//! (`TransactionsInvolvingAddress`). Serving them is what restores, after a rescan, the
+//! recipients, memos and fees of past sends and the memos of received notes, and it drains
+//! the queue (which is otherwise saved, ever growing, with the wallet). This follows the
+//! zcash-devtool / mobile SDK pattern: lightwalletd `GetTransaction` ->
+//! `decrypt_and_store_transaction` or `set_transaction_status`, `GetTaddressTxids` ->
+//! `decrypt_and_store_transaction` then `notify_address_checked`.
+//!
+//! Privacy (PORT-NOTES Decision 9): serving these requests tells lightwalletd which
+//! transactions belong to this client. After a restore it receives `GetTransaction` for every
+//! transaction scanning attributed to the wallet, and `GetStatus` is repeated every pass for
+//! each send it waits for. This is the standard light-client model (zcash-devtool, the mobile
+//! SDKs); compact-block scanning alone reveals nothing of the kind.
+//!
+//! Not served (counted as deferred, see PORT-NOTES "Deferred"): `TransactionsInvolvingAddress`
+//! requests without an end height. The backend emits them for every ephemeral (ZIP 320)
+//! address of the account, gap addresses included, with the whole chain as range; sqlite
+//! wallets space them out at randomized times (`schedule_next_check`, which this backend does
+//! not support). Served on every pass (every 30 s in Celari) they would ask the server about
+//! each ephemeral address over and over, linking them to one client. A restored wallet still
+//! learns the ephemeral outputs of ZIP 320 sends through the enhancement of the transactions
+//! scanning finds, but not their spends: the backend leaves ephemeral addresses out of the
+//! bounded spend searches (as zcash_client_sqlite does), and an ephemeral output created by a
+//! transaction the wallet funded becomes spendable only once its observed-unspent height passes
+//! that transaction's expiry, which only these unserved open-ended checks advance. So the value
+//! of a ZIP 320 pair whose second transaction expired unmined (made by another wallet with the
+//! same seed; Celari builds no multi-step proposals) stays unspendable in Celari: not lost, a
+//! wallet that serves these checks recovers it (verifier finding V-5).
+
+use std::future::Future;
+
+use tonic::client::GrpcService;
+use tonic::codegen::{Body, Bytes, StdError};
+use zcash_client_backend::data_api::wallet::decrypt_and_store_transaction;
+use zcash_client_backend::data_api::{TransactionDataRequest, TransactionStatus, WalletRead, WalletWrite};
+use zcash_client_backend::proto::service::{self, compact_tx_streamer_client::CompactTxStreamerClient};
+use zcash_keys::encoding::AddressCodec;
+use zcash_primitives::transaction::{Transaction, TxId};
+use zcash_protocol::consensus::{BlockHeight, BranchId, Parameters};
+
+/// Requests served per pass at most; the rest are served by the next passes (the backend asks
+/// again for whatever is still missing).
+pub const MAX_REQUESTS_PER_PASS: usize = 200;
+
+/// `RawTransaction.height` of a transaction the server knows but that is mined on a fork, not
+/// in the main chain (lightwalletd maps zcashd's -1 to this). Height 0 means "in the mempool".
+const HEIGHT_NOT_IN_MAIN_CHAIN: u64 = u64::MAX;
+
+/// Where full transactions come from: lightwalletd in the browser, captured data in tests.
+pub trait TxDataSource {
+    /// `GetTransaction` by txid: `None` if the server does not know the transaction.
+    fn get_transaction(
+        &mut self,
+        txid: TxId,
+    ) -> impl Future<Output = Result<Option<service::RawTransaction>, tonic::Status>>;
+
+    /// `GetTaddressTxids`: the mined transactions involving `address` in `start..=end`.
+    fn get_taddress_txids(
+        &mut self,
+        address: String,
+        start: BlockHeight,
+        end: BlockHeight,
+    ) -> impl Future<Output = Result<Vec<service::RawTransaction>, tonic::Status>>;
+}
+
+impl<T> TxDataSource for CompactTxStreamerClient<T>
+where
+    T: GrpcService<tonic::body::Body>,
+    T::Error: Into<StdError>,
+    T::ResponseBody: Body<Data = Bytes> + Send + 'static,
+    <T::ResponseBody as Body>::Error: Into<StdError> + Send,
+{
+    async fn get_transaction(&mut self, txid: TxId) -> Result<Option<service::RawTransaction>, tonic::Status> {
+        // The txid in its internal byte order, as compact blocks carry it (checked against
+        // zcash-mainnet.chainsafe.dev: the reversed order is "not found").
+        let filter = service::TxFilter { block: None, index: 0, hash: txid.as_ref().to_vec() };
+        match CompactTxStreamerClient::get_transaction(self, filter).await {
+            Ok(response) => Ok(Some(response.into_inner())),
+            // "GetTransaction: getrawtransaction … failed: -5: Transaction not found in mempool
+            // or best chain" comes with code NotFound.
+            Err(status) if status.code() == tonic::Code::NotFound => Ok(None),
+            Err(status) => Err(status),
+        }
+    }
+
+    async fn get_taddress_txids(
+        &mut self,
+        address: String,
+        start: BlockHeight,
+        end: BlockHeight,
+    ) -> Result<Vec<service::RawTransaction>, tonic::Status> {
+        let block = |h: BlockHeight| service::BlockId { height: u64::from(u32::from(h)), hash: vec![] };
+        let filter = service::TransparentAddressBlockFilter {
+            address,
+            range: Some(service::BlockRange { start: Some(block(start)), end: Some(block(end)), pool_types: vec![] }),
+        };
+        let mut stream = CompactTxStreamerClient::get_taddress_txids(self, filter).await?.into_inner();
+        let mut txs = vec![];
+        while let Some(tx) = stream.message().await? {
+            txs.push(tx);
+        }
+        Ok(txs)
+    }
+}
+
+/// What one serving round did.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct ServeReport {
+    /// Requests of the kinds this glue serves, as the backend listed them.
+    pub requests: u32,
+    /// Of those, the requests answered.
+    pub served: u32,
+    /// Of those, the requests that failed (left for the next pass).
+    pub failed: u32,
+    /// Requests of a kind this glue does not serve (see the module docs).
+    pub deferred: u32,
+}
+
+/// Whether this glue serves `request` (see the module docs for the ones it does not).
+pub fn is_served(request: &TransactionDataRequest) -> bool {
+    match request {
+        TransactionDataRequest::GetStatus(_) | TransactionDataRequest::Enhancement(_) => true,
+        TransactionDataRequest::TransactionsInvolvingAddress(r) => r.block_range_end().is_some(),
+        #[allow(unreachable_patterns)]
+        _ => false,
+    }
+}
+
+/// Why one request could not be served.
+#[derive(Debug)]
+enum ServeError<E> {
+    /// The server failed; the remaining requests wait for the next pass.
+    Server(tonic::Status),
+    /// The server answered with data that does not fit the request; the request stays.
+    BadData(String),
+    /// The wallet refused the data; the request stays.
+    Wallet(E),
+}
+
+/// Serves the backend's transaction data requests from `source`, at most `max_requests`.
+///
+/// Never fails: a request that cannot be served stays in the backend's queue for the next
+/// pass, and a server error ends the round. The caller's sync pass has already committed its
+/// blocks, and a failed round must not turn it into a failed pass (Celari saves the wallet only
+/// after a pass that succeeds).
+pub async fn serve_transaction_data_requests<P, DbT, S>(
+    params: &P,
+    db: &mut DbT,
+    source: &mut S,
+    max_requests: usize,
+) -> ServeReport
+where
+    P: Parameters,
+    DbT: WalletWrite,
+    <DbT as WalletRead>::Error: std::fmt::Display,
+    S: TxDataSource,
+{
+    let mut report = ServeReport::default();
+    let chain_tip = match db.chain_height() {
+        Ok(Some(tip)) => tip,
+        Ok(None) => return report,
+        Err(e) => {
+            tracing::error!("transaction data requests: no chain tip: {e}");
+            return report;
+        }
+    };
+    let requests = match db.transaction_data_requests() {
+        Ok(requests) => requests,
+        Err(e) => {
+            tracing::error!("transaction data requests: cannot list them: {e}");
+            return report;
+        }
+    };
+    let (mut served, deferred): (Vec<_>, Vec<_>) = requests.into_iter().partition(is_served);
+    report.deferred = deferred.len() as u32;
+    report.requests = served.len() as u32;
+    // Transactions first (they also answer the status of what they find), then the address
+    // searches.
+    served.sort_by_key(|r| matches!(r, TransactionDataRequest::TransactionsInvolvingAddress(_)));
+    for request in served.into_iter().take(max_requests) {
+        match serve_one(params, db, source, &request, chain_tip).await {
+            Ok(()) => report.served += 1,
+            Err(ServeError::Server(status)) => {
+                report.failed += 1;
+                tracing::warn!("transaction data request {request:?}: server error, retried next pass: {status}");
+                break;
+            }
+            Err(ServeError::BadData(why)) => {
+                report.failed += 1;
+                tracing::warn!("transaction data request {request:?}: {why}");
+            }
+            Err(ServeError::Wallet(e)) => {
+                report.failed += 1;
+                tracing::error!("transaction data request {request:?}: the wallet refused the data: {e}");
+            }
+        }
+    }
+    tracing::info!("transaction data requests: {report:?}");
+    report
+}
+
+/// The height a transaction was mined at, from `RawTransaction.height`.
+fn mined_height(height: u64) -> Result<Option<BlockHeight>, String> {
+    match height {
+        0 | HEIGHT_NOT_IN_MAIN_CHAIN => Ok(None),
+        h => u32::try_from(h)
+            .map(|h| Some(BlockHeight::from_u32(h)))
+            .map_err(|_| format!("the server reports an impossible height {h}")),
+    }
+}
+
+/// Parses a transaction from lightwalletd, with the consensus branch of the height it was
+/// mined at (or, if unmined, of the next block). Pre-v5 transactions do not encode their
+/// branch, so it must be the right one; v5 and v6 transactions carry their own.
+fn parse_tx<P: Parameters>(
+    params: &P,
+    raw: &service::RawTransaction,
+    chain_tip: BlockHeight,
+) -> Result<(Transaction, Option<BlockHeight>), String> {
+    let mined = mined_height(raw.height)?;
+    let branch = BranchId::for_height(params, mined.unwrap_or(chain_tip + 1));
+    let tx = Transaction::read(&raw.data[..], branch).map_err(|e| format!("cannot parse the transaction: {e}"))?;
+    Ok((tx, mined))
+}
+
+/// [`parse_tx`] for an answer to a request about `txid`: data that does not parse, or that is
+/// another transaction, is refused (the request stays for the next pass).
+fn parse_requested_tx<P: Parameters, E>(
+    params: &P,
+    raw: &service::RawTransaction,
+    chain_tip: BlockHeight,
+    txid: &TxId,
+) -> Result<(Transaction, Option<BlockHeight>), ServeError<E>> {
+    let (tx, mined) = parse_tx(params, raw, chain_tip).map_err(ServeError::BadData)?;
+    if tx.txid() != *txid {
+        return Err(ServeError::BadData(format!(
+            "the server answered with transaction {} for {txid}",
+            tx.txid()
+        )));
+    }
+    Ok((tx, mined))
+}
+
+async fn serve_one<P, DbT, S>(
+    params: &P,
+    db: &mut DbT,
+    source: &mut S,
+    request: &TransactionDataRequest,
+    chain_tip: BlockHeight,
+) -> Result<(), ServeError<<DbT as WalletRead>::Error>>
+where
+    P: Parameters,
+    DbT: WalletWrite,
+    S: TxDataSource,
+{
+    match request {
+        TransactionDataRequest::GetStatus(txid) => {
+            let status = match source.get_transaction(*txid).await.map_err(ServeError::Server)? {
+                None => TransactionStatus::TxidNotRecognized,
+                Some(raw) => {
+                    // The height is believed only for an answer that is the requested
+                    // transaction (verifier finding V-1): a wrong answer recorded as `Mined`
+                    // would keep an unmined send from ever expiring, so the notes it spent
+                    // would stay spent. As for `Enhancement`, this guards against a wrong
+                    // server, not a hostile one (which can lie about the height).
+                    let (_, mined) = parse_requested_tx(params, &raw, chain_tip, txid)?;
+                    match mined {
+                        Some(h) => TransactionStatus::Mined(h),
+                        None => TransactionStatus::NotInMainChain,
+                    }
+                }
+            };
+            db.set_transaction_status(*txid, status).map_err(ServeError::Wallet)
+        }
+        TransactionDataRequest::Enhancement(txid) => {
+            let Some(raw) = source.get_transaction(*txid).await.map_err(ServeError::Server)? else {
+                // No data available: say so, which ends the enhancement request.
+                return db
+                    .set_transaction_status(*txid, TransactionStatus::TxidNotRecognized)
+                    .map_err(ServeError::Wallet);
+            };
+            let (tx, mined) = parse_requested_tx(params, &raw, chain_tip, txid)?;
+            decrypt_and_store_transaction(params, db, &tx, mined).map_err(ServeError::Wallet)?;
+            if raw.height == HEIGHT_NOT_IN_MAIN_CHAIN {
+                db.set_transaction_status(*txid, TransactionStatus::NotInMainChain)
+                    .map_err(ServeError::Wallet)?;
+            }
+            Ok(())
+        }
+        TransactionDataRequest::TransactionsInvolvingAddress(r) => {
+            let Some(end) = r.block_range_end() else {
+                // Not served (`is_served`).
+                return Ok(());
+            };
+            let start = r.block_range_start();
+            // The request's range is `start..end`; lightwalletd's is inclusive.
+            let last = BlockHeight::from_u32(u32::from(end).saturating_sub(1));
+            if end > start {
+                let txs = source
+                    .get_taddress_txids(r.address().encode(params), start, last)
+                    .await
+                    .map_err(ServeError::Server)?;
+                for raw in &txs {
+                    let (tx, mined) = parse_tx(params, raw, chain_tip).map_err(ServeError::BadData)?;
+                    if mined.is_some_and(|h| h < start || h >= end) {
+                        return Err(ServeError::BadData(format!(
+                            "the server returned transaction {} at {mined:?}, outside {start}..{end}",
+                            tx.txid()
+                        )));
+                    }
+                    decrypt_and_store_transaction(params, db, &tx, mined).map_err(ServeError::Wallet)?;
+                }
+            }
+            // Every transaction of the range involving the address is now stored, so whatever
+            // output of the address is still unspent is unspent as of the range's end. (Called
+            // also when transactions were found: one that does not spend the output would
+            // otherwise leave the same request in place for every following pass.)
+            db.notify_address_checked(r.clone(), last).map_err(ServeError::Wallet)
+        }
+        #[allow(unreachable_patterns)]
+        _ => Ok(()),
+    }
+}
