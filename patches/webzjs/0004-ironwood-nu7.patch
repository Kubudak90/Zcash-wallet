+/// `pczt_send` reads the network tip, then waits for the wallet database, which a sync pass
+/// holds for its whole duration (Celari's sync loop keeps running during a spend). If NU7
+/// activates during that wait, the branch check runs against the tip read before it: R1's rule
+/// says the NU6.3 PCZT must be refused once the next block is NU7's.
+#[tokio::test]
+async fn send_checks_the_branch_against_a_tip_read_before_waiting_for_the_database() {
+    let mut c = Chain::new();
+    c.receive_ironwood(2_000_000);
+    c.empty_to(3_543_393, true);
+    c.empty_to(3_543_407, false);
+    let mock = MockLwd::new(3_543_393);
+    c.serve(&mock, 3_543_393);
+    let wallet = c.wallet(&mock);
+    let stale = wallet.pczt_create(c.account, recipient(), 100_000, None).await.expect("built at target 3,543,394");
+    assert_eq!(*stale.global().consensus_branch_id(), NU6_3_BRANCH);
+    let stale = sign_and_prove(stale, &c.usk);
+    let txs = tx_count(&wallet).await;
+
+    // A sync pass holds the database when the user sends.
+    let guard = wallet.db.write().await;
+    let before = mock.count("GetLatestBlock");
+    let driver = {
+        let mock = mock.clone();
+        let c = &c;
+        async move {
+            // pczt_send has read the tip (3,543,393) and waits for the database ...
+            while mock.count("GetLatestBlock") == before {
+                tokio::task::yield_now().await;
+            }
+            for _ in 0..50 {
+                tokio::task::yield_now().await;
+            }
+            // ... while NU7 activates; then the pass ends.
+            c.serve(&mock, 3_543_407);
+            drop(guard);
+        }
+    };
+    let (sent, ()) = tokio::join!(wallet.pczt_send(stale), driver);
+    let stored = unmined(&wallet).await;
+    let branches: Vec<_> = {
+        let db = wallet.db.read().await;
+        stored.iter().map(|t| db.get_transaction(*t).unwrap().unwrap().consensus_branch_id()).collect()
+    };
+    println!(
+        "send while NU7 activated during the wait: {sent:?}; SendTransaction {}; stored unmined {:?} branches {branches:?}; \
+         tx count {} -> {}; Ironwood spendable now {}",
+        mock.count("SendTransaction"),
+        stored,
+        txs,
+        tx_count(&wallet).await,
+        ironwood_spendable(&wallet, c.account).await
+    );
+    assert!(
+        matches!(sent, Err(Error::PcztWrongBranch { .. })),
+        "R1: an NU6.3 transaction must not be stored or broadcast once the next block is NU7's; got {sent:?}"
+    );
+    assert_eq!(mock.count("SendTransaction"), 0);
+    assert_eq!(tx_count(&wallet).await, txs);
+}
