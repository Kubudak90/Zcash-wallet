+//! Review finding R4: serving the wallet's transaction data requests restores what compact
+//! blocks lack (outgoing recipients, memos, fees, mined status) and drains the queue.
+
+use std::collections::HashMap;
+
+use transparent::address::Script;
+use transparent::bundle::{OutPoint, TxOut};
+use zcash_client_backend::data_api::testing::{orchard::OrchardPoolTester, pool::ShieldedPoolTester};
+use zcash_client_backend::data_api::ll::LowLevelWalletWrite;
+use zcash_client_backend::data_api::wallet::ConfirmationsPolicy;
+use zcash_client_backend::data_api::{Account as _, TransactionDataRequest, WalletRead, WalletWrite};
+use zcash_client_backend::proto::service::{compact_tx_streamer_client::CompactTxStreamerClient, RawTransaction};
+use zcash_client_backend::wallet::WalletTransparentOutput;
+use zcash_primitives::transaction::TxId;
+use zcash_protocol::consensus::BlockHeight;
+use zcash_protocol::memo::{Memo, MemoBytes};
+use zcash_protocol::value::Zatoshis;
+
+use super::boundary::mainnet_wallet;
+use super::fixtures::*;
+use super::history::entry;
+use super::mock_lwd::{mainnet, MockLwd};
+use crate::bindgen::transaction_history::TransactionType;
+use crate::data_requests::{is_served, serve_transaction_data_requests, TxDataSource, MAX_REQUESTS_PER_PASS};
+
+/// Transactions by txid, as a lightwalletd that has them would answer `GetTransaction`.
+#[derive(Default)]
+struct Fetched(HashMap<TxId, RawTransaction>, Vec<String>);
+
+impl TxDataSource for Fetched {
+    async fn get_transaction(&mut self, txid: TxId) -> Result<Option<RawTransaction>, tonic::Status> {
+        self.1.push(format!("GetTransaction {txid}"));
+        Ok(self.0.get(&txid).cloned())
+    }
+    async fn get_taddress_txids(
+        &mut self,
+        address: String,
+        start: BlockHeight,
+        end: BlockHeight,
+    ) -> Result<Vec<RawTransaction>, tonic::Status> {
+        self.1.push(format!("GetTaddressTxids {address} {start}..={end}"));
+        Ok(vec![])
+    }
+}
+
+fn raw(st: &St, txid: TxId, height: u64) -> RawTransaction {
+    let tx = st.wallet().get_transaction(txid).unwrap().expect("the wallet built it");
+    let mut data = vec![];
+    tx.write(&mut data).unwrap();
+    RawTransaction { data, height }
+}
+
+fn served_requests(st: &St) -> Vec<TransactionDataRequest> {
+    st.wallet().transaction_data_requests().unwrap().into_iter().filter(is_served).collect()
+}
+
+/// A payment with a memo, seen again after a rebuild and rescan from the seed (Decision 2):
+/// without enhancement the history has neither the recipient's amount nor the fee nor the
+/// memo; serving the enhancement request (lightwalletd `GetTransaction` of the full
+/// transaction) restores all three, and leaves no request open.
+#[tokio::test]
+async fn enhancement_restores_a_rescanned_payment() {
+    let (mut st, account, usk, seed, birthday) = seed_wallet(ironwood_network(None));
+    let h = receive_ironwood(&mut st, &usk, Zatoshis::const_from_u64(1_000_000));
+    let memo = MemoBytes::from(Memo::from_bytes(b"thanks for the coffee").unwrap());
+    let amount = Zatoshis::const_from_u64(300_000);
+    let (txid, h2, fee) = pay_outside(&mut st, account, &usk, amount, Some(memo));
+    let original = entry(&st, account, txid);
+    assert_eq!((original.tx_type(), original.value()), (TransactionType::Sent, -300_000));
+    assert_eq!(original.memo().as_deref(), Some("thanks for the coffee"));
+    // What lightwalletd would return for the payment (the receipt was only a fake compact
+    // transaction, so the server "does not know" it).
+    let mut source = Fetched::default();
+    source.0.insert(txid, raw(&st, txid, u64::from(u32::from(h2))));
+
+    st.reset();
+    let (account, _) = st.wallet_mut().create_account("a", &seed, &birthday, None).unwrap();
+    st.scan_cached_blocks(h, 2);
+    let rescanned = entry(&st, account, txid);
+    assert_eq!(rescanned.tx_type(), TransactionType::Sent);
+    assert_eq!(rescanned.value(), -((u64::from(amount) + u64::from(fee)) as i64));
+    assert_eq!(rescanned.memo(), None, "compact blocks carry no memo");
+    assert_eq!(rescanned.fee(), None, "nor the fee");
+    let open = served_requests(&st);
+    assert!(open.contains(&TransactionDataRequest::Enhancement(txid)), "{open:?}");
+
+    let network = st.network().clone();
+    let report = serve_transaction_data_requests(&network, st.wallet_mut(), &mut source, MAX_REQUESTS_PER_PASS).await;
+    eprintln!("report {report:?}, calls {:?}", source.1);
+    assert_eq!(report.failed, 0);
+    assert_eq!(report.served, report.requests);
+
+    let enhanced = entry(&st, account, txid);
+    assert_eq!((enhanced.tx_type(), enhanced.value()), (TransactionType::Sent, -300_000));
+    assert_eq!(enhanced.fee(), Some(u64::from(fee)));
+    assert_eq!(enhanced.memo().as_deref(), Some("thanks for the coffee"));
+    assert!(served_requests(&st).is_empty(), "the queue drained: {:?}", served_requests(&st));
+
+    // A second round has nothing to do.
+    let again = serve_transaction_data_requests(&network, st.wallet_mut(), &mut source, MAX_REQUESTS_PER_PASS).await;
+    assert_eq!((again.requests, again.served), (0, 0));
+}
+
+/// A transaction this wallet sent and is waiting for: `GetStatus` while it is in the mempool
+/// (height 0) keeps the request; once lightwalletd reports it mined, the wallet records the
+/// height and the request goes quiet. (The backend, like zcash_client_sqlite, queues a status
+/// request only for a send that scanning cannot observe, e.g. one funded by transparent
+/// inputs; here it is queued directly for a shielded send.)
+#[tokio::test]
+async fn status_requests_follow_the_server() {
+    let (mut st, account, usk, _, _) = seed_wallet(ironwood_network(None));
+    receive_ironwood(&mut st, &usk, Zatoshis::const_from_u64(1_000_000));
+    let to = OrchardPoolTester::sk_default_address(&OrchardPoolTester::sk(&[0xf5; 32]));
+    let request = zcash_client_backend::zip321::TransactionRequest::new(vec![zcash_client_backend::zip321::Payment::without_memo(
+        to.to_zcash_address(st.network()),
+        Zatoshis::const_from_u64(100_000),
+    )])
+    .unwrap();
+    let proposal = st
+        .propose_transfer(
+            account,
+            &zcash_client_backend::data_api::wallet::input_selection::GreedyInputSelector::new(),
+            &webzjs_change_strategy(),
+            request,
+            ConfirmationsPolicy::MIN,
+        )
+        .unwrap();
+    let txid = *st
+        .create_proposed_transactions::<std::convert::Infallible, _, std::convert::Infallible, _>(
+            &usk,
+            zcash_client_backend::wallet::OvkPolicy::Sender,
+            &proposal,
+        )
+        .unwrap()
+        .first();
+    let network = st.network().clone();
+    st.wallet_mut().queue_tx_status(txid).unwrap();
+    let open = served_requests(&st);
+    eprintln!("open after sending: {open:?}");
+    assert!(open.contains(&TransactionDataRequest::GetStatus(txid)), "{open:?}");
+
+    let mut mempool = Fetched::default();
+    mempool.0.insert(txid, raw(&st, txid, 0));
+    serve_transaction_data_requests(&network, st.wallet_mut(), &mut mempool, MAX_REQUESTS_PER_PASS).await;
+    assert!(served_requests(&st).contains(&TransactionDataRequest::GetStatus(txid)), "still waiting");
+    assert_eq!(st.wallet().tx_table().get(&txid).unwrap().mined_height(), None);
+
+    let tip = st.wallet().chain_height().unwrap().unwrap();
+    let mut mined = Fetched::default();
+    mined.0.insert(txid, raw(&st, txid, u64::from(u32::from(tip))));
+    serve_transaction_data_requests(&network, st.wallet_mut(), &mut mined, MAX_REQUESTS_PER_PASS).await;
+    assert_eq!(st.wallet().tx_table().get(&txid).unwrap().mined_height(), Some(tip));
+    assert!(!served_requests(&st).contains(&TransactionDataRequest::GetStatus(txid)));
+}
+
+/// Builds (does not mine) a payment of `amount` to an Orchard receiver outside the wallet.
+fn build_unmined_payment(st: &mut St, account: zcash_client_memory::AccountId, usk: &zcash_keys::keys::UnifiedSpendingKey, amount: u64) -> TxId {
+    let to = OrchardPoolTester::sk_default_address(&OrchardPoolTester::sk(&[0xf5; 32]));
+    let request = zcash_client_backend::zip321::TransactionRequest::new(vec![zcash_client_backend::zip321::Payment::without_memo(
+        to.to_zcash_address(st.network()),
+        Zatoshis::const_from_u64(amount),
+    )])
+    .unwrap();
+    let proposal = st
+        .propose_transfer(
+            account,
+            &zcash_client_backend::data_api::wallet::input_selection::GreedyInputSelector::new(),
+            &webzjs_change_strategy(),
+            request,
+            ConfirmationsPolicy::MIN,
+        )
+        .unwrap();
+    *st.create_proposed_transactions::<std::convert::Infallible, _, std::convert::Infallible, _>(
+        usk,
+        zcash_client_backend::wallet::OvkPolicy::Sender,
+        &proposal,
+    )
+    .unwrap()
+    .first()
+}
+
+/// Verifier finding V-1: a `GetStatus` answer is used only if its data is the requested
+/// transaction. The wallet's own unmined send X waits for its status; the server answers
+/// `GetTransaction(X)` at the chain tip with other data: bytes that are not a transaction, or
+/// another real transaction (Y). Taken at face value, X would be recorded as mined, would never
+/// expire, and the note it spent would stay spent (and its unmined change counted) after its
+/// expiry. Now the answer is refused like a wrong `Enhancement` answer: the request stays open,
+/// X stays unmined, and once X has expired its input is spendable again.
+#[tokio::test]
+async fn status_answer_must_be_the_requested_transaction() {
+    for other_tx in [false, true] {
+        let (mut st, account, usk, _, _) = seed_wallet(ironwood_network(None));
+        receive_ironwood(&mut st, &usk, Zatoshis::const_from_u64(1_000_000));
+        receive_ironwood(&mut st, &usk, Zatoshis::const_from_u64(1_000_000));
+        let x = build_unmined_payment(&mut st, account, &usk, 100_000);
+        let y = build_unmined_payment(&mut st, account, &usk, 100_000);
+        assert_ne!(x, y);
+        st.wallet_mut().queue_tx_status(x).unwrap();
+        let open = served_requests(&st);
+        assert!(open.contains(&TransactionDataRequest::GetStatus(x)));
+        let tip = st.wallet().chain_height().unwrap().unwrap();
+        let at_tip = u64::from(u32::from(tip));
+        let answer = if other_tx {
+            raw(&st, y, at_tip)
+        } else {
+            RawTransaction { data: vec![0xde, 0xad, 0xbe, 0xef], height: at_tip }
+        };
+        let mut server = Fetched::default();
+        server.0.insert(x, answer);
+        let network = st.network().clone();
+        let report = serve_transaction_data_requests(&network, st.wallet_mut(), &mut server, MAX_REQUESTS_PER_PASS).await;
+        let mined = st.wallet().tx_table().get(&x).unwrap().mined_height();
+        let still_open = served_requests(&st).contains(&TransactionDataRequest::GetStatus(x));
+        // Past the expiry of X and Y (default delta 40 blocks).
+        for _ in 0..45 {
+            let (h, _) = st.generate_empty_block();
+            st.scan_cached_blocks(h, 1);
+        }
+        let spendable = u64::from(st.get_spendable_balance(account, ConfirmationsPolicy::MIN));
+        let total = u64::from(st.get_total_balance(account));
+        eprintln!(
+            "answer is {}: open {open:?}, report {report:?}, calls {:?}, X mined at {mined:?}, request open {still_open}; \
+             after expiry spendable {spendable} total {total}",
+            if other_tx { "another transaction" } else { "not a transaction" },
+            server.1,
+        );
+        // The other open requests (the sends' own status checks) get "not found" and are
+        // served; only the wrong answer fails.
+        assert_eq!((report.requests, report.served, report.failed), (open.len() as u32, open.len() as u32 - 1, 1), "the answer is refused");
+        assert_eq!(mined, None, "X is not recorded as mined");
+        assert!(still_open, "the request stays for the next pass");
+        assert_eq!((spendable, total), (2_000_000, 2_000_000), "both inputs are back after X and Y expired");
+    }
+}
+
+/// Through the real gRPC client (`CompactTxStreamerClient`, as in the browser) against the mock
+/// serving two real mainnet transactions captured from lightwalletd (v6, NU6.3; one with
+/// Ironwood actions): the txid goes out in internal byte order, the transactions parse with
+/// their height's branch, and a txid the server does not know ends its request too.
+#[tokio::test]
+async fn real_mainnet_transactions_through_grpc() {
+    let mock = MockLwd::new(mainnet::LAST).with_mainnet_data();
+    let (wallet, _) = mainnet_wallet(&mock, Some(mainnet::LAST));
+    let txid = |hex: &str| TxId::from_bytes(hex::decode(hex).unwrap().try_into().unwrap());
+    let unknown = TxId::from_bytes([0xab; 32]);
+    {
+        let mut db = wallet.db.write().await;
+        db.queue_tx_retrieval(
+            [txid(mainnet::TX_IRONWOOD.0), txid(mainnet::TX_SAPLING.0), unknown].into_iter(),
+            None,
+        )
+        .unwrap();
+    }
+    let (served, deferred) = wallet.pending_data_requests().await.unwrap();
+    assert_eq!(served, 3);
+    let mut client = CompactTxStreamerClient::new(mock.clone());
+    let report = {
+        let mut db = wallet.db.write().await;
+        serve_transaction_data_requests(&webzjs_common::Network::MainNetwork, &mut *db, &mut client, MAX_REQUESTS_PER_PASS).await
+    };
+    eprintln!("report {report:?}, deferred {deferred}, calls {:?}", mock.calls());
+    assert_eq!((report.requests, report.served, report.failed), (3, 3, 0));
+    for hex in [mainnet::TX_IRONWOOD.0, mainnet::TX_SAPLING.0] {
+        assert!(mock.calls().contains(&format!("GetTransaction {hex}")));
+    }
+    assert_eq!(wallet.pending_data_requests().await.unwrap().0, 0, "drained");
+    // Nothing in them is the wallet's: nothing stored.
+    assert_eq!(wallet.db.read().await.tx_table().iter().count(), 0);
+}
+
+/// The spend search for a transparent output of the wallet (`TransactionsInvolvingAddress`
+/// with an end height): `GetTaddressTxids` over the requested range (inclusive end), then
+/// `notify_address_checked`, which ends the request. Open-ended ephemeral-address checks are
+/// not served (module docs) and are counted as deferred.
+#[tokio::test]
+async fn transparent_spend_search() {
+    let (mut st, account, _, _, _) = seed_wallet(ironwood_network(None));
+    for _ in 0..3 {
+        let (hh, _) = st.generate_empty_block();
+        st.scan_cached_blocks(hh, 1);
+    }
+    let tip = st.wallet().chain_height().unwrap().unwrap();
+    let taddr = st
+        .wallet()
+        .get_account(account)
+        .unwrap()
+        .unwrap()
+        .uivk()
+        .default_transparent_address()
+        .unwrap()
+        .0;
+    let outpoint = OutPoint::new([0x42; 32], 0);
+    let output = WalletTransparentOutput::from_parts(
+        outpoint.clone(),
+        TxOut::new(Zatoshis::const_from_u64(70_000), Script::from(taddr.script())),
+        Some(tip),
+        Some(account),
+        None,
+        None,
+    )
+    .unwrap();
+    st.wallet_mut().put_received_transparent_utxo(&output).unwrap();
+    st.wallet_mut().queue_transparent_spend_detection(taddr, *outpoint.txid(), 0).unwrap();
+    // The output counts as observed unspent at the tip it was put at; the search covers the
+    // blocks after that.
+    for _ in 0..2 {
+        let (hh, _) = st.generate_empty_block();
+        st.scan_cached_blocks(hh, 1);
+    }
+    let new_tip = st.wallet().chain_height().unwrap().unwrap();
+    let network = st.network().clone();
+    let before = st.wallet().transaction_data_requests().unwrap();
+    eprintln!("requests: {before:?}");
+    let search = served_requests(&st);
+    assert!(
+        search.iter().any(|r| matches!(r, TransactionDataRequest::TransactionsInvolvingAddress(a) if a.address() == taddr && a.block_range_end().is_some())),
+        "{search:?}"
+    );
+
+    let mut source = Fetched::default();
+    let report = serve_transaction_data_requests(&network, st.wallet_mut(), &mut source, MAX_REQUESTS_PER_PASS).await;
+    eprintln!("report {report:?}, calls {:?}", source.1);
+    assert_eq!(report.failed, 0);
+    let address = zcash_keys::encoding::AddressCodec::encode(&taddr, &network);
+    assert!(
+        source.1.contains(&format!("GetTaddressTxids {address} {}..={new_tip}", tip + 1)),
+        "range [first block not yet checked, tip]: {:?}",
+        source.1
+    );
+    assert!(
+        !served_requests(&st).iter().any(|r| matches!(r, TransactionDataRequest::TransactionsInvolvingAddress(a) if a.address() == taddr)),
+        "the search ended: {:?}",
+        served_requests(&st)
+    );
+}
+
+/// `Wallet::sync` serves the requests after scanning (before the fix it never did, so a
+/// restored wallet's queue only grew): a sync over the captured mainnet blocks with three
+/// enhancement requests open leaves none, and the pass counters report them.
+#[tokio::test]
+async fn sync_serves_and_drains_the_queue() {
+    let mock = MockLwd::new(mainnet::LAST).with_mainnet_data();
+    let (wallet, _) = mainnet_wallet(&mock, Some(mainnet::LAST));
+    let txid = |hex: &str| TxId::from_bytes(hex::decode(hex).unwrap().try_into().unwrap());
+    wallet
+        .db
+        .write()
+        .await
+        .queue_tx_retrieval(
+            [txid(mainnet::TX_IRONWOOD.0), txid(mainnet::TX_SAPLING.0), TxId::from_bytes([0xab; 32])].into_iter(),
+            None,
+        )
+        .unwrap();
+    assert_eq!(wallet.pending_data_requests().await.unwrap().0, 3);
+    wallet.sync().await.unwrap();
+    let p = wallet.sync_progress();
+    eprintln!("after sync: {p:?}");
+    assert_eq!(wallet.pending_data_requests().await.unwrap().0, 0, "drained by the sync pass");
+    assert_eq!((p.data_requests, p.data_requests_served, p.data_requests_failed), (3, 3, 0));
+    assert_eq!(mock.count("GetTransaction"), 3);
+}
