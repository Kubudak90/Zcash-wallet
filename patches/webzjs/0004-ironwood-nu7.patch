+//! Test-framework wallets with webzjs-wallet's spending parameters.
+
+use std::convert::Infallible;
+use std::num::NonZeroUsize;
+
+use secrecy::Secret;
+use zcash_client_backend::data_api::testing::{
+    orchard::OrchardPoolTester, pool::ShieldedPoolTester, AddressType, IronwoodFvk, TestBuilder,
+    TestState,
+};
+use zcash_client_backend::data_api::wallet::{input_selection::GreedyInputSelector, ConfirmationsPolicy};
+use zcash_client_backend::data_api::{AccountBirthday, WalletWrite};
+use zcash_client_backend::fees::{standard::MultiOutputChangeStrategy, DustOutputPolicy, SplitPolicy, StandardFeeRule};
+use zcash_client_backend::wallet::OvkPolicy;
+use zcash_client_backend::zip321::{Payment, TransactionRequest};
+use zcash_client_memory::{testing::TestMemDbFactory, AccountId, MemBlockCache, MemoryWalletDb};
+use zcash_keys::keys::UnifiedSpendingKey;
+use zcash_primitives::block::BlockHash;
+use zcash_primitives::transaction::TxId;
+use zcash_protocol::consensus::BlockHeight;
+use zcash_protocol::local_consensus::LocalNetwork;
+use zcash_protocol::memo::MemoBytes;
+use zcash_protocol::value::Zatoshis;
+use zcash_protocol::ShieldedPool;
+
+pub(crate) type St = TestState<MemBlockCache, MemoryWalletDb<LocalNetwork>, LocalNetwork>;
+
+/// The test network with every upgrade through NU6.3 at Sapling activation, and NU7
+/// `nu7_offset` blocks later if given.
+pub(crate) fn ironwood_network(nu7_offset: Option<u32>) -> LocalNetwork {
+    let base = TestBuilder::<(), ()>::DEFAULT_NETWORK;
+    let start = base.sapling.unwrap();
+    LocalNetwork {
+        nu6: Some(start),
+        nu6_1: Some(start),
+        nu6_2: Some(start),
+        nu6_3: Some(start),
+        nu7: nu7_offset.map(|o| start + o),
+        ..base
+    }
+}
+
+/// webzjs-wallet's change strategy (`Wallet::change_strategy` after NU6.3): ZIP 317, change
+/// to Ironwood, split into up to 4 notes of at least 0.1 ZEC.
+pub(crate) fn webzjs_change_strategy() -> MultiOutputChangeStrategy<MemoryWalletDb<LocalNetwork>> {
+    MultiOutputChangeStrategy::new(
+        StandardFeeRule::Zip317,
+        None,
+        ShieldedPool::Ironwood,
+        DustOutputPolicy::default(),
+        SplitPolicy::with_min_output_value(NonZeroUsize::new(4).unwrap(), Zatoshis::const_from_u64(10_000_000)),
+    )
+}
+
+/// A wallet with one seed account (seed `[7; 32]`) born at Sapling activation.
+pub(crate) fn seed_wallet(network: LocalNetwork) -> (St, AccountId, UnifiedSpendingKey, Secret<Vec<u8>>, AccountBirthday) {
+    let mut st = TestBuilder::new()
+        .with_network(network)
+        .with_data_store_factory(TestMemDbFactory::new())
+        .with_block_cache(MemBlockCache::new())
+        .build();
+    let seed = Secret::new([7u8; 32].to_vec());
+    let birthday = AccountBirthday::from_sapling_activation(st.network(), BlockHash([0; 32]));
+    let (account, usk) = st.wallet_mut().create_account("a", &seed, &birthday, None).unwrap();
+    (st, account, usk, seed, birthday)
+}
+
+/// Receives `value` into Ironwood in the next block and scans it; returns its height.
+pub(crate) fn receive_ironwood(st: &mut St, usk: &UnifiedSpendingKey, value: Zatoshis) -> BlockHeight {
+    let iw = IronwoodFvk(OrchardPoolTester::sk_to_fvk(OrchardPoolTester::usk_to_sk(usk)));
+    let (h, _, _) = st.generate_next_block(&iw, AddressType::DefaultExternal, value);
+    st.scan_cached_blocks(h, 1);
+    h
+}
+
+/// Pays `amount` (with `memo`) to an Orchard receiver outside the wallet, with webzjs's
+/// change strategy, mines the transaction in the next block and scans it. Returns the txid,
+/// its height and the fee.
+pub(crate) fn pay_outside(
+    st: &mut St,
+    account: AccountId,
+    usk: &UnifiedSpendingKey,
+    amount: Zatoshis,
+    memo: Option<MemoBytes>,
+) -> (TxId, BlockHeight, Zatoshis) {
+    let to = OrchardPoolTester::sk_default_address(&OrchardPoolTester::sk(&[0xf5; 32]));
+    let payment = Payment::new(to.to_zcash_address(st.network()), Some(amount), memo, None, None, vec![]).unwrap();
+    let request = TransactionRequest::new(vec![payment]).unwrap();
+    let proposal = st
+        .propose_transfer(account, &GreedyInputSelector::new(), &webzjs_change_strategy(), request, ConfirmationsPolicy::MIN)
+        .unwrap();
+    let fee = proposal.steps().head.balance().fee_required();
+    let txid = *st
+        .create_proposed_transactions::<Infallible, _, Infallible, _>(usk, OvkPolicy::Sender, &proposal)
+        .unwrap()
+        .first();
+    let (h, _) = st.generate_next_block_including(txid);
+    st.scan_cached_blocks(h, 1);
+    (txid, h, fee)
+}
