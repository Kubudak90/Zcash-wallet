diff --git a/crates/webzjs-wallet/src/runtime.rs b/crates/webzjs-wallet/src/runtime.rs
new file mode 100644
index 0000000..b56c63f
--- /dev/null
+++ b/crates/webzjs-wallet/src/runtime.rs
@@ -0,0 +1,73 @@
+//! Side effects the zcash_client_backend 0.25 wallet operations take as parameters: a
+//! clock, a cryptographically secure RNG, and the choices that depend on the network
+//! upgrade in force (change pool, Orchard circuit version).
+
+use std::time::{Duration, SystemTime};
+
+use rand::rngs::{StdRng, SysRng};
+use rand::SeedableRng;
+use zcash_client_backend::util::Clock;
+use zcash_protocol::consensus::{BlockHeight, BranchId, NetworkUpgrade, OrchardProtocolRevision, Parameters};
+use zcash_protocol::ShieldedPool;
+
+use crate::error::Error;
+
+/// A [`Clock`] that works in the browser.
+///
+/// `zcash_client_backend::util::SystemClock` calls `std::time::SystemTime::now`, which panics
+/// on `wasm32-unknown-unknown`. The `time` crate (with its `wasm-bindgen` feature, enabled in
+/// this crate's manifest) reads the JavaScript clock instead.
+#[derive(Clone, Copy, Debug, Default)]
+pub struct WebClock;
+
+impl Clock for WebClock {
+    fn now(&self) -> SystemTime {
+        let nanos = time::OffsetDateTime::now_utc().unix_timestamp_nanos();
+        // Before 1970 cannot happen on a working clock; clamp rather than panic.
+        SystemTime::UNIX_EPOCH + Duration::from_nanos(u64::try_from(nanos).unwrap_or(0))
+    }
+}
+
+/// A CSPRNG seeded from the platform's secure randomness (`crypto.getRandomValues` in the
+/// browser, through getrandom's `wasm_js` backend). Fails, rather than falling back to
+/// weak randomness, when none is available.
+pub fn secure_rng() -> Result<StdRng, Error> {
+    StdRng::try_from_rng(&mut SysRng)
+        .map_err(|e| Error::Generic(format!("No secure randomness available: {e}")))
+}
+
+/// The shielded pool that receives change when the transaction's own flows do not decide
+/// it (shielding, for example): Ironwood once NU6.3 is active at `target_height`, Orchard
+/// before. zcash_client_backend additionally routes change away from Orchard after NU6.3
+/// unless the Orchard pool's balance strictly decreases (the turnstile), so no new value
+/// enters the Orchard pool.
+pub fn fallback_change_pool<P: Parameters>(params: &P, target_height: BlockHeight) -> ShieldedPool {
+    if params.is_nu_active(NetworkUpgrade::Nu6_3, target_height) {
+        ShieldedPool::Ironwood
+    } else {
+        ShieldedPool::Orchard
+    }
+}
+
+/// The Orchard circuit a PCZT's Orchard and Ironwood proofs must be made with, from its
+/// consensus branch. The insecure pre-NU6.2 circuit is refused.
+pub fn orchard_circuit_version(
+    consensus_branch_id: u32,
+) -> Result<orchard::circuit::OrchardCircuitVersion, Error> {
+    let branch = BranchId::try_from(consensus_branch_id)
+        .map_err(|_| Error::PcztProve(format!("unknown consensus branch {consensus_branch_id:#010x}")))?;
+    match branch.orchard_protocol_revision() {
+        Some(OrchardProtocolRevision::V3) => Ok(orchard::circuit::OrchardCircuitVersion::PostNu6_3),
+        Some(OrchardProtocolRevision::V2) => Ok(orchard::circuit::OrchardCircuitVersion::FixedPostNu6_2),
+        Some(OrchardProtocolRevision::InsecureV1) => Err(Error::PcztProve(
+            "refusing to prove with the insecure pre-NU6.2 Orchard circuit".to_string(),
+        )),
+        None => Err(Error::PcztProve(format!(
+            "consensus branch {branch:?} has no Orchard protocol"
+        ))),
+        #[allow(unreachable_patterns)]
+        Some(_) => Err(Error::PcztProve(format!(
+            "unsupported Orchard protocol revision for {branch:?}"
+        ))),
+    }
+}
diff --git a/crates/webzjs-wallet/src/tests/addresses.rs b/crates/webzjs-wallet/src/tests/addresses.rs
