+        "v2 shield pipeline: {sent:?}; version {:?} branch {:?} expiry {} transparent inputs {}",
+        tx.version(),
+        tx.consensus_branch_id(),
+        u32::from(tx.expiry_height()),
+        tx.transparent_bundle().map_or(0, |b| b.vin.len())
+    );
+    sent.expect("shielding accepted in NU7");
+    assert_eq!(tx.consensus_branch_id(), BranchId::Nu7);
+    assert!(u32::from(tx.expiry_height()) > NU7);
+}
+
+/// R1 says `pczt_send` refuses, before storing anything, a PCZT whose branch is not the next
+/// block's. It reads the network tip first and only then waits for the wallet database, which
+/// Celari's sync loop holds for a whole pass (the controller does not stop the loop during a
+/// spend). If NU7 activates during that wait the check runs on the old tip: the NU6.3
+/// transaction is stored (its note spent), the node refuses it, and the note stays locked.
+#[tokio::test]
+async fn v2_stale_tip_during_a_pass_stores_an_old_epoch_tx_the_node_refuses() {
+    let mut c = Chain::new();
+    c.receive_ironwood(2_000_000);
+    c.empty_to(3_543_393, true);
+    c.empty_to(3_543_440, false);
+    let mock = MockLwd::new(3_543_393);
+    mock.0.lock().unwrap().node_branch_check = true;
+    c.serve(&mock, 3_543_393);
+    let wallet = c.wallet(&mock);
+    let pczt = wallet.pczt_create(c.account, recipient(), 100_000, None).await.expect("built at target 3,543,394");
+    assert_eq!(*pczt.global().consensus_branch_id(), NU6_3_BRANCH);
+    let expiry = *pczt.global().expiry_height();
+    let proved = app_sign_prove(&wallet, pczt, &c.usk).await;
+    let (txs, spendable) = (tx_count(&wallet).await, ironwood_spendable(&wallet, c.account).await);
+
+    // A sync pass holds the database when pczt_send starts; NU7 activates before it ends.
+    let guard = wallet.db.write().await;
+    let before = mock.count("GetLatestBlock");
+    let driver = {
+        let mock = mock.clone();
+        let c = &c;
+        async move {
+            // Until pczt_send has asked for the tip (or, if it waits for the database first,
+            // long enough for it to be waiting).
+            for _ in 0..2000 {
+                if mock.count("GetLatestBlock") > before {
+                    break;
+                }
+                tokio::task::yield_now().await;
+            }
+            for _ in 0..50 {
+                tokio::task::yield_now().await;
+            }
+            c.serve(&mock, 3_543_407);
+            drop(guard);
+        }
+    };
+    let (sent, ()) = tokio::join!(wallet.pczt_send(proved), driver);
+    let stored = unmined(&wallet).await;
+    let after = ironwood_spendable(&wallet, c.account).await;
+    println!(
+        "v2 stale tip: pczt_send -> {sent:?}; SendTransaction calls {}; txs {txs} -> {}; unmined {stored:?}; \
+         Ironwood spendable {spendable} -> {after}; PCZT expiry {expiry}",
+        mock.count("SendTransaction"),
+        tx_count(&wallet).await,
+    );
+    // Is the note locked? A new send of the same amount, NU7 now active.
+    let again = wallet.pczt_create(c.account, recipient(), 100_000, None).await;
+    println!("v2 stale tip: a new pczt_create right after -> {:?}", again.as_ref().map(|p| *p.global().consensus_branch_id()));
+    // After the old transaction's expiry height.
+    c.serve(&mock, 3_543_440);
+    let later = wallet.pczt_create(c.account, recipient(), 100_000, None).await;
+    println!(
+        "v2 stale tip: at network 3,543,440 (past expiry {expiry}) -> {:?}; Ironwood spendable {}",
+        later.as_ref().map(|p| *p.global().consensus_branch_id()),
+        ironwood_spendable(&wallet, c.account).await
+    );
+    assert!(matches!(sent, Err(Error::PcztWrongBranch { .. })), "R1: refused before storing; got {sent:?}");
+    assert_eq!(mock.count("SendTransaction"), 0, "nothing broadcast");
+    assert_eq!(tx_count(&wallet).await, txs, "nothing stored");
+    assert_eq!(after, spendable, "no input locked");
+}
+
+/// Servers behind one URL a block apart at activation (the controller's readTip says they
+/// can be): GetLatestBlock answers 3,543,404 (next block NU7's), the node SendTransaction
+/// reaches is at 3,543,403 (next block NU6.3's). Before the fix of NU7-2 the NU7 PCZT passed
+/// pczt_send's check, was stored, the node refused it, and its input stayed locked until its
+/// expiry (120 blocks). Now nothing is built for the activation block itself
+/// (`UpgradePending`, 0 blocks left); one block later (GetLatestBlock 3,543,405, the node one
+/// behind at 3,543,404, whose next block is NU7's too) the NU7 transaction is built, stored and
+/// accepted.
+#[tokio::test]
+async fn v2_backends_a_block_apart_at_activation() {
+    let mut c = Chain::new();
+    c.receive_ironwood(2_000_000);
+    c.empty_to(3_543_404, true);
+    c.empty_to(3_543_405, false);
+    let mock = MockLwd::new(3_543_404);
+    {
+        let mut s = mock.0.lock().unwrap();
+        s.node_branch_check = true;
+        s.node_tip = Some(3_543_403);
+    }
+    c.serve(&mock, 3_543_404);
+    let wallet = c.wallet(&mock);
+    let txs = tx_count(&wallet).await;
+    let refused = wallet.pczt_create(c.account, recipient(), 100_000, None).await;
+    println!(
+        "v2 backends apart, GetLatestBlock 3,543,404 / node 3,543,403: pczt_create -> {:?}",
+        refused.as_ref().map(|p| *p.global().consensus_branch_id())
+    );
+    assert!(
+        matches!(refused, Err(Error::UpgradePending { activation_height: NU7, blocks_left: 0, .. })),
+        "nothing is built for the activation block: {refused:?}"
+    );
+    assert_eq!(tx_count(&wallet).await, txs, "nothing stored");
+    assert_eq!(mock.count("SendTransaction"), 0);
+
+    // One block later.
+    c.serve(&mock, 3_543_405);
+    mock.0.lock().unwrap().node_tip = Some(3_543_404);
+    let pczt = wallet.pczt_create(c.account, recipient(), 100_000, None).await.expect("NU7 build");
+    assert_eq!(*pczt.global().consensus_branch_id(), NU7_BRANCH);
+    let expiry = *pczt.global().expiry_height();
+    let proved = app_sign_prove(&wallet, pczt, &c.usk).await;
+    let sent = wallet.pczt_send(proved).await;
+    println!(
+        "v2 backends apart, GetLatestBlock 3,543,405 / node 3,543,404: pczt_send -> {sent:?}; txs {txs} -> {}; \
+         unmined {:?}; expiry {expiry}",
+        tx_count(&wallet).await,
+        unmined(&wallet).await,
+    );
+    sent.expect("accepted by the node one block behind: its next block is NU7's");
+    assert_eq!(sent_tx(&mock, 0).consensus_branch_id(), BranchId::Nu7);
+}
