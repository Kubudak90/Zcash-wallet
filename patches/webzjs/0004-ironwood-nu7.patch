+//! `bindgen::transaction_history::extract_transaction_history` over real wallet tables.
+
+use zcash_client_backend::data_api::{WalletRead, WalletWrite};
+use zcash_protocol::value::Zatoshis;
+use zcash_protocol::TxId;
+
+use super::fixtures::*;
+use crate::bindgen::transaction_history::{extract_transaction_history, TransactionHistoryEntry, TransactionType};
+
+/// The history entry of `txid` for `account`.
+pub(crate) fn entry(st: &St, account: zcash_client_memory::AccountId, txid: TxId) -> TransactionHistoryEntry {
+    let tip = st.wallet().chain_height().unwrap().map(u32::from);
+    let history = extract_transaction_history(st.wallet(), *account, tip, 100, 0).unwrap();
+    history
+        .entries()
+        .iter()
+        .find(|e| e.txid() == txid.to_string())
+        .cloned()
+        .unwrap_or_else(|| panic!("no history entry for {txid}"))
+}
+
+/// Review finding R0: a payment to someone else, seen again after the wallet was rebuilt from
+/// its seed and rescanned (Decision 2's forced rescan of every existing Celari wallet, and any
+/// restore), must still read as a payment. Compact-block scanning records only the change
+/// output (a `sent_notes` row to the account itself), so "a sent output is recorded" does not
+/// mean "the transaction's outputs are known"; only the full transaction data does.
+/// (The review's `rescanned_send_is_classified_by_webzjs_history`, now over the real function.)
+#[test]
+fn rescanned_send_is_not_an_internal_transfer() {
+    let (mut st, account, usk, seed, birthday) = seed_wallet(ironwood_network(None));
+    let value = Zatoshis::const_from_u64(1_000_000);
+    let h = receive_ironwood(&mut st, &usk, value);
+    let amount = Zatoshis::const_from_u64(300_000);
+    let (txid, _, fee) = pay_outside(&mut st, account, &usk, amount, None);
+
+    // The wallet that made the payment knows its outputs.
+    let sent = entry(&st, account, txid);
+    assert_eq!((sent.tx_type(), sent.value()), (TransactionType::Sent, -300_000));
+    assert_eq!(sent.fee(), Some(u64::from(fee)));
+
+    // Rebuilt from the seed and rescanned: only compact blocks, so the outputs are unknown.
+    st.reset();
+    let (account, _) = st.wallet_mut().create_account("a", &seed, &birthday, None).unwrap();
+    st.scan_cached_blocks(h, 2);
+    let rescanned = entry(&st, account, txid);
+    assert_eq!(
+        (rescanned.tx_type(), rescanned.value()),
+        (TransactionType::Sent, -((u64::from(amount) + u64::from(fee)) as i64)),
+        "a rescanned payment must not read as an internal transfer"
+    );
+    // The receipt is still a receipt.
+    let received = extract_transaction_history(st.wallet(), *account, None, 100, 0).unwrap();
+    assert!(received
+        .entries()
+        .iter()
+        .any(|e| e.tx_type() == TransactionType::Received && e.value() == 1_000_000));
+}
