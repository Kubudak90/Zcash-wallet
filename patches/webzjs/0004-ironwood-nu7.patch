@@ -0,0 +1,378 @@
+//! Review finding R1: the NU7 boundary (mainnet activation 3,543,405).
+
+use std::convert::Infallible;
+
+use prost::Message;
+use secrecy::SecretVec;
+use zcash_client_backend::data_api::testing::{orchard::OrchardPoolTester, pool::ShieldedPoolTester, AddressType};
+use zcash_client_backend::data_api::wallet::{
+    extract_and_store_transaction_from_pczt, input_selection::GreedyInputSelector, ConfirmationsPolicy,
+};
+use zcash_client_backend::data_api::{AccountBirthday, WalletRead, WalletWrite};
+use zcash_client_backend::proto::service::TreeState;
+use zcash_client_backend::wallet::OvkPolicy;
+use zcash_client_backend::zip321::{Payment, TransactionRequest};
+use zcash_client_memory::MemoryWalletDb;
+use zcash_proofs::prover::LocalTxProver;
+use zcash_protocol::consensus::{BlockHeight, BranchId, NetworkUpgrade, Parameters, MAIN_NETWORK};
+use zcash_protocol::value::Zatoshis;
+
+use super::fixtures::*;
+use super::mock_lwd::{grpcweb_messages, mainnet, MockLwd};
+use crate::boundary::*;
+use crate::error::Error;
+use crate::runtime::{orchard_circuit_version, secure_rng, WebClock};
+use crate::wallet::extract_and_store_minable_pczt;
+use crate::Wallet;
+use webzjs_common::Network;
+
+const NU7: u32 = 3_543_405;
+const NU6_3_BRANCH: u32 = 0x37a5_165b;
+const NU7_BRANCH: u32 = 0x7719_0ad9;
+fn h(height: u32) -> BlockHeight {
+    BlockHeight::from_u32(height)
+}
+
+#[test]
+fn mainnet_heights_are_the_ones_these_rules_assume() {
+    assert_eq!(MAIN_NETWORK.activation_height(NetworkUpgrade::Nu7), Some(h(NU7)));
+    assert_eq!(u32::from(BranchId::for_height(&MAIN_NETWORK, h(NU7 - 1))), NU6_3_BRANCH);
+    assert_eq!(u32::from(BranchId::for_height(&MAIN_NETWORK, h(NU7))), NU7_BRANCH);
+}
+
+/// The review's scenario and its neighbours: when must a PCZT build sync first?
+#[test]
+fn sync_before_building_around_nu7() {
+    let m = &Network::MainNetwork;
+    // Wallet tip 3,543,400 (next block NU6.3), network 3,543,407 (next block NU7): only 7
+    // blocks behind, under the old 10-block rule, but the epochs differ.
+    assert!(must_sync_before_building(m, h(3_543_400), h(3_543_407)));
+    // Same tip, next block 3,543,404 (NU6.3) one block before activation: sync anyway.
+    assert!(must_sync_before_building(m, h(3_543_403), h(3_543_403)));
+    // Within 20 blocks either side of activation.
+    assert!(must_sync_before_building(m, h(3_543_384), h(3_543_385))); // next 3,543,385: 20 before
+    assert!(!must_sync_before_building(m, h(3_543_383), h(3_543_384))); // next 3,543,384: 21 before
+    assert!(must_sync_before_building(m, h(3_543_424), h(3_543_424))); // next 3,543,425: 20 after
+    assert!(!must_sync_before_building(m, h(3_543_425), h(3_543_426))); // next 3,543,426: 21 after
+    // Far from any activation: the old rule only.
+    assert!(!must_sync_before_building(m, h(3_533_000), h(3_533_010)));
+    assert!(must_sync_before_building(m, h(3_533_000), h(3_533_011)));
+    // A lagging server (wallet ahead by a block) is not a reason to sync.
+    assert!(!must_sync_before_building(m, h(3_533_001), h(3_533_000)));
+}
+
+#[test]
+fn no_build_in_the_last_blocks_before_nu7() {
+    let m = &Network::MainNetwork;
+    assert!(check_build_target(m, h(NU7 - UPGRADE_SEND_PAUSE - 1)).is_ok());
+    for target in NU7 - UPGRADE_SEND_PAUSE..NU7 {
+        match check_build_target(m, h(target)) {
+            Err(Error::UpgradePending { activation_height, blocks_left, branch }) => {
+                assert_eq!((activation_height, blocks_left, branch), (NU7, NU7 - target, NU6_3_BRANCH));
+            }
+            other => panic!("target {target}: {other:?}"),
+        }
+    }
+    // After the activation block, the new epoch: no further upgrade is scheduled on mainnet.
+    assert!(check_build_target(m, h(NU7 + 1)).is_ok());
+    assert!(check_build_target(m, h(NU7 + 2)).is_ok());
+}
+
+/// Verifier finding NU7-2: the pause also covers the activation block itself, so nothing is
+/// built for it and nothing for the new branch is sent while the network's tip is still the
+/// last block of the old epoch (a backend one block behind would refuse it, and the stored
+/// transaction would lock its inputs until its expiry, 120 blocks later).
+#[test]
+fn the_activation_block_is_in_the_pause() {
+    let m = &Network::MainNetwork;
+    match check_build_target(m, h(NU7)) {
+        Err(Error::UpgradePending { activation_height, blocks_left, branch }) => {
+            assert_eq!((activation_height, blocks_left, branch), (NU7, 0, NU7_BRANCH));
+        }
+        other => panic!("target NU7: {other:?}"),
+    }
+    // An NU7 PCZT sent while the network's tip is the last NU6.3 block: refused.
+    assert!(matches!(
+        check_minable(m, NU7_BRANCH, NU7 + 120, h(NU7 - 1)),
+        Err(Error::UpgradePending { activation_height: NU7, blocks_left: 0, .. })
+    ));
+    // From the network's tip at the activation height on, accepted.
+    assert!(check_minable(m, NU7_BRANCH, NU7 + 120, h(NU7)).is_ok());
+    assert!(check_minable(m, NU7_BRANCH, NU7 + 121, h(NU7 + 1)).is_ok());
+}
+
+#[test]
+fn send_refuses_what_cannot_be_mined() {
+    let m = &Network::MainNetwork;
+    // The review's PCZT: built at target 3,543,401 (NU6.3, expiry +40), sent with the
+    // network at 3,543,407: the next block is NU7's.
+    assert!(matches!(
+        check_minable(m, NU6_3_BRANCH, 3_543_441, h(3_543_407)),
+        Err(Error::PcztWrongBranch { pczt_branch: NU6_3_BRANCH, network_branch: NU7_BRANCH, next_height: 3_543_408 })
+    ));
+    // The same PCZT built at NU7's target is fine.
+    assert!(check_minable(m, NU7_BRANCH, 3_543_528, h(3_543_407)).is_ok());
+    // An NU7 PCZT before activation is refused as well.
+    assert!(matches!(check_minable(m, NU7_BRANCH, 3_543_528, h(3_543_300)), Err(Error::PcztWrongBranch { .. })));
+    // Expiry: at or below the tip + 3 (zcashd's expiring-soon threshold) is refused; 0 never
+    // expires.
+    assert!(check_minable(m, NU6_3_BRANCH, 3_533_904, h(3_533_900)).is_ok());
+    assert!(matches!(
+        check_minable(m, NU6_3_BRANCH, 3_533_903, h(3_533_900)),
+        Err(Error::PcztExpired { expiry_height: 3_533_903, network_tip: 3_533_900 })
+    ));
+    assert!(matches!(check_minable(m, NU6_3_BRANCH, 3_533_900, h(3_533_900)), Err(Error::PcztExpired { .. })));
+    assert!(matches!(check_minable(m, NU6_3_BRANCH, 3_533_000, h(3_533_900)), Err(Error::PcztExpired { .. })));
+    assert!(check_minable(m, NU6_3_BRANCH, 0, h(3_533_900)).is_ok());
+    // The last blocks of the old epoch: an NU6.3 transaction for the block 8 before NU7.
+    assert!(matches!(check_minable(m, NU6_3_BRANCH, 3_543_437, h(NU7 - 9)), Err(Error::UpgradePending { .. })));
+    assert!(check_minable(m, NU6_3_BRANCH, 3_543_434, h(NU7 - 12)).is_ok());
+}
