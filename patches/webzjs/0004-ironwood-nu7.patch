+/// `pczt_send` with an NU6.3 PCZT once NU7 is active: refused before anything is stored or
+/// broadcast (before the fix the PCZT went to `extract_and_store_transaction_from_pczt`).
+#[tokio::test]
+async fn pczt_send_refuses_an_old_epoch_pczt_before_storing() {
+    let mock = MockLwd::new(3_543_407);
+    let (wallet, _) = mainnet_wallet(&mock, Some(3_543_400));
+    let pczt = pczt::roles::creator::Creator::new(NU6_3_BRANCH, 3_543_441, 133, None, None)
+        .unwrap()
+        .build()
+        .unwrap();
+    let result = wallet.pczt_send(pczt).await;
+    assert!(
+        matches!(result, Err(Error::PcztWrongBranch { next_height: 3_543_408, .. })),
+        "refused for its branch, before extraction: {result:?}"
+    );
+    assert_eq!(mock.count("SendTransaction"), 0);
+    assert_eq!(wallet.db.read().await.tx_table().iter().count(), 0, "nothing stored");
+}
+
+/// Verifier findings V-4 / NU7-1: `pczt_send` reads the network tip, then waits for the
+/// database write lock, which a sync pass holds for its whole length (Celari keeps syncing
+/// during a spend). The branch, expiry and pause checks must use the tip as of when nothing
+/// else can store, not the one read before the wait: here the network crosses NU7 (3,543,393
+/// -> 3,543,406) while `pczt_send` waits, and the NU6.3 PCZT must be refused before extraction.
+#[tokio::test]
+async fn send_checks_the_tip_read_after_waiting_for_the_database() {
+    let mock = MockLwd::new(3_543_393);
+    let (wallet, _) = mainnet_wallet(&mock, Some(3_543_393));
+    let pczt = pczt::roles::creator::Creator::new(NU6_3_BRANCH, 3_543_433, 133, None, None)
+        .unwrap()
+        .build()
+        .unwrap();
+    // A sync pass holds the write lock.
+    let guard = wallet.db.write().await;
+    let send = wallet.pczt_send(pczt);
+    let mut send = std::pin::pin!(send);
+    let parked = tokio::select! {
+        biased;
+        r = &mut send => Some(r),
+        _ = async { for _ in 0..200 { tokio::task::yield_now().await } } => None,
+    };
+    assert!(parked.is_none(), "pczt_send waits for the lock: {parked:?}");
+    assert_eq!(mock.count("GetLatestBlock"), 1, "it read the tip before waiting");
+    // Meanwhile the network reaches NU7 (activation 3,543,405).
+    mock.0.lock().unwrap().latest = 3_543_406;
+    drop(guard);
+    let result = send.await;
+    eprintln!("pczt_send after the wait: {result:?}; calls {:?}", mock.calls());
+    assert!(
+        matches!(
+            result,
+            Err(Error::PcztWrongBranch { pczt_branch: NU6_3_BRANCH, network_branch: NU7_BRANCH, next_height: 3_543_407 })
+        ),
+        "an NU6.3 PCZT is refused when the next block is NU7's by the time it would be stored: {result:?}"
+    );
+    assert_eq!(mock.count("SendTransaction"), 0);
+    assert_eq!(wallet.db.read().await.tx_table().iter().count(), 0, "nothing stored");
+}
+
+/// `pczt_create` with the wallet's tip at 3,543,400 and the network at 3,543,407 syncs first
+/// (before the fix it did not: 7 blocks is under the old 10-block rule, so it built an NU6.3
+/// transaction for an NU7 chain). The mock has no blocks there, so the sync fails and the
+/// create fails with it; what matters is that the sync was attempted and nothing was built.
+#[tokio::test]
+async fn pczt_create_syncs_when_the_network_crossed_nu7() {
+    let mock = MockLwd::new(3_543_407);
+    mock.0.lock().unwrap().unavailable.insert("GetSubtreeRoots");
+    let (wallet, account) = mainnet_wallet(&mock, Some(3_543_400));
+    let to = wallet.current_address(account).await.unwrap().unwrap();
+    let to = address_of(&wallet, to);
+    let result = wallet.pczt_create(account, to, 10_000, None).await;
+    assert!(mock.count("GetSubtreeRoots") >= 1, "a sync pass started: {:?}", mock.calls());
+    assert!(matches!(result, Err(Error::Sync(_))), "{result:?}");
+}
+
+/// And far from any activation, a few blocks behind: no sync, straight to the proposal (which
+/// fails: the wallet owns nothing).
+#[tokio::test]
+async fn pczt_create_does_not_sync_needlessly() {
+    let mock = MockLwd::new(3_533_905);
+    mock.0.lock().unwrap().unavailable.insert("GetSubtreeRoots");
+    let (wallet, account) = mainnet_wallet(&mock, Some(3_533_900));
+    let to = wallet.current_address(account).await.unwrap().unwrap();
+    let to = address_of(&wallet, to);
+    let result = wallet.pczt_create(account, to, 10_000, None).await;
