+//! Review finding R3: a sync pass frees each batch of compact blocks once scanned, and a pass
+//! with a time budget ends at a batch boundary so the wallet can be saved.
+
+use std::future::Future;
+use std::pin::Pin;
+use std::sync::atomic::{AtomicUsize, Ordering::Relaxed};
+use std::sync::Arc;
+
+use async_trait::async_trait;
+use zcash_client_backend::data_api::chain::{error::Error as ChainError, BlockCache, BlockSource};
+use zcash_client_backend::data_api::scanning::ScanRange;
+use zcash_client_backend::data_api::WalletRead;
+use zcash_client_backend::proto::compact_formats::CompactBlock;
+use zcash_client_backend::proto::service::compact_tx_streamer_client::CompactTxStreamerClient;
+use zcash_client_memory::MemBlockCache;
+use zcash_protocol::consensus::BlockHeight;
+
+use super::boundary::mainnet_wallet;
+use super::mock_lwd::{mainnet, MockLwd};
+use crate::progress::{ProgressCache, SyncCounters};
+
+/// A `MemBlockCache` that records the most blocks it ever held.
+#[derive(Default)]
+struct PeakCache {
+    inner: MemBlockCache,
+    peak: Arc<AtomicUsize>,
+}
+
+impl BlockSource for PeakCache {
+    type Error = std::convert::Infallible;
+    fn with_blocks<F, WalletErrT>(
+        &self,
+        from_height: Option<BlockHeight>,
+        limit: Option<usize>,
+        with_block: F,
+    ) -> Result<(), ChainError<WalletErrT, Self::Error>>
+    where
+        F: FnMut(CompactBlock) -> Result<(), ChainError<WalletErrT, Self::Error>>,
+    {
+        self.inner.with_blocks(from_height, limit, with_block)
+    }
+}
+
+#[async_trait]
+impl BlockCache for PeakCache {
+    fn get_tip_height(&self, range: Option<&ScanRange>) -> Result<Option<BlockHeight>, Self::Error> {
+        self.inner.get_tip_height(range)
+    }
+    async fn read(&self, range: &ScanRange) -> Result<Vec<CompactBlock>, Self::Error> {
+        self.inner.read(range).await
+    }
+    async fn insert(&self, blocks: Vec<CompactBlock>) -> Result<(), Self::Error> {
+        self.inner.insert(blocks).await?;
+        self.peak.fetch_max(self.inner.len(), Relaxed);
+        Ok(())
+    }
+    // Forwarded as called, so that what is measured is ProgressCache's and MemBlockCache's
+    // timing of the removal.
+    fn delete<'life0, 'async_trait>(
+        &'life0 self,
+        range: ScanRange,
+    ) -> Pin<Box<dyn Future<Output = Result<(), Self::Error>> + Send + 'async_trait>>
+    where
+        'life0: 'async_trait,
+        Self: 'async_trait,
+    {
+        self.inner.delete(range)
+    }
+}
+
+/// `ProgressCache` (the cache `Wallet::sync` passes to `sync::run`) frees a batch's blocks when
+/// `run` calls `delete`, not when `run` awaits the returned future at the end of the pass.
+#[test]
+fn progress_cache_delete_frees_when_called() {
+    let cache = ProgressCache::new(MemBlockCache::new(), Arc::new(SyncCounters::default()));
+    let blocks: Vec<CompactBlock> = (100..110u64).map(|h| CompactBlock { height: h, ..Default::default() }).collect();
+    futures_util::FutureExt::now_or_never(cache.insert(blocks)).unwrap().unwrap();
+    let pending = cache.delete(ScanRange::from_parts(
+        BlockHeight::from(100)..BlockHeight::from(110),
+        zcash_client_backend::data_api::scanning::ScanPriority::Historic,
+    ));
+    let left = futures_util::FutureExt::now_or_never(cache.read(&ScanRange::from_parts(
+        BlockHeight::from(100)..BlockHeight::from(110),
+        zcash_client_backend::data_api::scanning::ScanPriority::Historic,
+    )))
+    .unwrap()
+    .unwrap();
+    assert_eq!(left.len(), 0, "the blocks are gone before the delete future is awaited");
+    drop(pending);
+}
+
+/// A whole `sync::run` pass over the 109 captured mainnet blocks in batches of 20 never holds
+/// more than one batch (before the fix it held all 109 until the pass ended).
+#[tokio::test]
+async fn a_pass_holds_one_batch_at_a_time() {
+    let mock = MockLwd::new(mainnet::LAST).with_mainnet_data();
+    let (wallet, _) = mainnet_wallet(&mock, None);
+    let peak = Arc::new(AtomicUsize::new(0));
+    let cache = ProgressCache::new(PeakCache { inner: MemBlockCache::new(), peak: peak.clone() }, wallet.progress.clone());
+    let mut client = CompactTxStreamerClient::new(mock.clone());
+    let mut db = wallet.db.write().await;
+    zcash_client_backend::sync::run(&mut client, &webzjs_common::Network::MainNetwork, &cache, &mut *db, 20)
+        .await
+        .unwrap();
+    assert_eq!(
+        db.block_fully_scanned().unwrap().map(|m| u32::from(m.block_height())),
+        Some(mainnet::LAST)
+    );
+    let batches = mock.count("GetBlockRange");
+    eprintln!("batches {batches}, peak cached blocks {}, calls {:?}", peak.load(Relaxed), mock.calls());
+    assert!(batches >= 6, "109 blocks in batches of 20");
+    assert!(peak.load(Relaxed) <= 20, "at most one batch in the cache, held {}", peak.load(Relaxed));
+}
+
+/// `Wallet::sync` with a time budget of 0: every pass ends (successfully, `ended_early`) after
+/// one batch, the caller saves and calls again, and the passes together scan the range exactly
+/// once, leaving the same wallet as one pass without a budget.
+#[tokio::test]
+async fn budgeted_passes_end_early_and_add_up_to_one_pass() {
+    // One pass without a budget.
+    let mock = MockLwd::new(mainnet::LAST).with_mainnet_data();
+    let (mut whole, _) = mainnet_wallet(&mock, None);
+    whole.batch_size = 20;
+    whole.set_sync_pass_ms(0);
+    whole.sync().await.unwrap();
+    let p = whole.sync_progress();
+    assert!(!p.ended_early);
+    assert_eq!(p.visited, mainnet::LAST - mainnet::FIRST + 1);
+    assert_eq!(p.ironwood_actions, 382);
+
+    // The same with a budget that runs out at once.
+    let mock = MockLwd::new(mainnet::LAST).with_mainnet_data();
+    let (mut wallet, _) = mainnet_wallet(&mock, None);
+    wallet.batch_size = 20;
+    wallet.set_sync_pass_ms(1);
+    let (mut passes, mut visited, mut ironwood) = (0, 0, 0);
+    loop {
+        passes += 1;
+        assert!(passes < 20, "the passes make progress");
+        wallet.sync().await.unwrap();
+        let p = wallet.sync_progress();
+        assert!(!p.running);
+        assert!(p.downloaded <= 20, "one batch per pass: {p:?}");
+        assert_eq!(p.scanned, p.downloaded, "a pass that ends early committed what it downloaded");
+        visited += p.visited;
+        ironwood += p.ironwood_actions;
+        // Saved between passes, as Celari does, and reopened.
+        let bytes = wallet.db_to_bytes().await.unwrap();
+        let reopened = zcash_client_memory::MemoryWalletDb::decode_new(&bytes, webzjs_common::Network::MainNetwork, crate::PRUNING_DEPTH).unwrap();
+        *wallet.db.write().await = reopened;
+        if !p.ended_early {
+            break;
+        }
+    }
+    eprintln!("passes {passes}, visited {visited}, ironwood actions {ironwood}, calls {}", mock.calls().len());
+    assert!(passes >= 6);
+    assert_eq!(visited, mainnet::LAST - mainnet::FIRST + 1, "every block scanned once");
+    assert_eq!(ironwood, 382);
+    let scanned = |w: &crate::Wallet<zcash_client_memory::MemoryWalletDb<webzjs_common::Network>, MockLwd>| {
+        futures_util::FutureExt::now_or_never(w.db.read()).unwrap().block_fully_scanned().unwrap().map(|m| u32::from(m.block_height()))
+    };
+    assert_eq!(scanned(&wallet), Some(mainnet::LAST));
+    assert!(
+        whole.db_to_bytes().await.unwrap() == wallet.db_to_bytes().await.unwrap(),
+        "the budgeted passes leave the same wallet as one pass"
+    );
+}
