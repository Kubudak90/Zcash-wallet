+//! `Wallet::pczt_create` / `pczt_shield` / `pczt_send` end to end, with the wallet's chain tip
+//! and the network's on either side of mainnet's NU7 activation (3,543,405). Written by the
+//! round-4 verifiers (NU7 lens, `../verify-nu7/`), adopted in round 5 with the fixes of their
+//! findings NU7-1 (the tip is read again once `pczt_send` holds the database) and NU7-2 (the
+//! upgrade pause covers the activation block).
+//!
+//! The wallet holds a real Ironwood note (zcash_client_backend's test framework over the memory
+//! backend) on a local chain whose upgrades sit at mainnet's heights in the range that matters
+//! (NU6.3 from 3,543,300, NU7 at 3,543,405). The `Wallet` itself runs with mainnet parameters,
+//! as in the browser, and talks to `MockLwd` serving that chain's compact blocks and tree states.
+
+use std::collections::BTreeMap;
+
+use incrementalmerkletree::frontier::CommitmentTree;
+use prost::Message;
+use secrecy::Secret;
+use transparent::address::Script;
+use transparent::bundle::{OutPoint, TxOut};
+use webzjs_common::Network;
+use zcash_client_backend::data_api::chain::ChainState;
+use zcash_client_backend::data_api::testing::{
+    orchard::OrchardPoolTester, pool::ShieldedPoolTester, AddressType, IronwoodFvk, TestBuilder,
+};
+use zcash_client_backend::data_api::wallet::ConfirmationsPolicy;
+use zcash_client_backend::data_api::{Account as _, AccountBirthday, WalletRead, WalletWrite};
+use zcash_client_backend::proto::compact_formats::{ChainMetadata, CompactBlock};
+use zcash_client_backend::proto::service::TreeState;
+use zcash_client_backend::wallet::WalletTransparentOutput;
+use zcash_client_memory::{testing::TestMemDbFactory, AccountId, MemBlockCache, MemoryWalletDb};
+use zcash_keys::keys::UnifiedSpendingKey;
+use zcash_primitives::block::BlockHash;
+use zcash_primitives::merkle_tree::write_commitment_tree;
+use zcash_protocol::consensus::{BlockHeight, BranchId};
+use zcash_protocol::local_consensus::LocalNetwork;
+use zcash_protocol::value::Zatoshis;
+use zcash_protocol::PoolType;
+
+use super::boundary::sign_and_prove;
+use super::fixtures::St;
+use super::mock_lwd::MockLwd;
+use crate::error::Error;
+use crate::Wallet;
+
+const START: u32 = 3_543_300;
+const NU7: u32 = 3_543_405;
+const NU6_3_BRANCH: u32 = 0x37a5_165b;
+const NU7_BRANCH: u32 = 0x7719_0ad9;
+
+fn h(x: u32) -> BlockHeight {
+    BlockHeight::from_u32(x)
+}
+
+/// Every upgrade through NU6.3 at 3,543,300, NU7 at mainnet's 3,543,405.
+fn chain_params() -> LocalNetwork {
+    chain_params_from(START)
+}
+
+fn chain_params_from(start: u32) -> LocalNetwork {
+    let s = Some(h(start));
+    LocalNetwork {
+        overwinter: Some(h(1)),
+        sapling: s,
+        blossom: s,
+        heartwood: s,
+        canopy: s,
+        nu5: s,
+        nu6: s,
+        nu6_1: s,
+        nu6_2: s,
+        nu6_3: s,
+        nu7: Some(h(NU7)),
+        ..TestBuilder::<(), ()>::DEFAULT_NETWORK
+    }
+}
+
+type W = Wallet<MemoryWalletDb<LocalNetwork>, MockLwd>;
+
+struct Chain {
+    start: u32,
+    st: St,
+    account: AccountId,
+    usk: UnifiedSpendingKey,
+    /// The chain state after each generated block.
+    states: BTreeMap<u32, ChainState>,
+}
+
+impl Chain {
+    fn new() -> Self {
+        Self::with_start(START)
+    }
+
+    fn with_start(start: u32) -> Self {
+        let mut st = TestBuilder::new()
+            .with_network(chain_params_from(start))
+            .with_data_store_factory(TestMemDbFactory::new())
+            .with_block_cache(MemBlockCache::new())
+            .build();
+        let seed = Secret::new([7u8; 32].to_vec());
+        let birthday = AccountBirthday::from_sapling_activation(st.network(), BlockHash([0; 32]));
+        let (account, usk) = st.wallet_mut().create_account("a", &seed, &birthday, None).unwrap();
+        Chain { start, st, account, usk, states: BTreeMap::new() }
+    }
+
+    fn tip(&self) -> u32 {
+        self.st.latest_cached_block().map_or(0, |b| u32::from(b.height()))
+    }
+
+    fn record(&mut self) {
+        let b = self.st.latest_cached_block().unwrap();
+        self.states.insert(u32::from(b.height()), b.chain_state().clone());
+    }
+
+    /// An Ironwood note of `value` for the account in the next block, scanned by the wallet.
+    fn receive_ironwood(&mut self, value: u64) -> BlockHeight {
+        let iw = IronwoodFvk(OrchardPoolTester::sk_to_fvk(OrchardPoolTester::usk_to_sk(&self.usk)));
+        let (hh, _, _) = self
+            .st
+            .generate_next_block(&iw, AddressType::DefaultExternal, Zatoshis::const_from_u64(value));
+        self.record();
+        self.st.scan_cached_blocks(hh, 1);
+        hh
+    }
+
+    /// An Orchard note of `value` for the account in the next block, scanned by the wallet (an
+    /// existing user's Orchard funds).
+    fn receive_orchard(&mut self, value: u64) -> BlockHeight {
+        let fvk = OrchardPoolTester::sk_to_fvk(OrchardPoolTester::usk_to_sk(&self.usk));
+        let (hh, _, _) = self
+            .st
+            .generate_next_block(&fvk, AddressType::DefaultExternal, Zatoshis::const_from_u64(value));
+        self.record();
+        self.st.scan_cached_blocks(hh, 1);
+        hh
+    }
+
+    /// Empty blocks up to `to`; the wallet scans them only if `scan`.
+    fn empty_to(&mut self, to: u32, scan: bool) {
+        while self.tip() < to {
+            let (hh, _) = self.st.generate_empty_block();
+            self.record();
+            if scan {
+                self.st.scan_cached_blocks(hh, 1);
+            }
+        }
+    }
+
+    fn compact_block(&self, height: u32) -> CompactBlock {
+        let cs = &self.states[&height];
+        let prev = &self.states[&(height - 1)];
+        let sizes = |c: &ChainState| {
+            (
+                c.final_sapling_tree().tree_size() as u32,
+                c.final_orchard_tree().tree_size() as u32,
+                c.final_ironwood_tree().tree_size() as u32,
+            )
+        };
+        assert_eq!(sizes(cs), sizes(prev), "only empty blocks are served");
+        let (s, o, i) = sizes(cs);
+        CompactBlock {
+            height: height.into(),
+            hash: cs.block_hash().0.to_vec(),
+            prev_hash: prev.block_hash().0.to_vec(),
+            chain_metadata: Some(ChainMetadata {
+                sapling_commitment_tree_size: s,
+                orchard_commitment_tree_size: o,
+                ironwood_commitment_tree_size: i,
+            }),
+            ..Default::default()
+        }
+    }
+
+    fn tree_state(&self, height: u32) -> TreeState {
+        let cs = &self.states[&height];
+        let mut sapling = vec![];
+        write_commitment_tree(&CommitmentTree::<sapling::Node, 32>::from_frontier(cs.final_sapling_tree()), &mut sapling).unwrap();
+        let mut orchard = vec![];
+        write_commitment_tree(
+            &CommitmentTree::<orchard::tree::MerkleHashOrchard, 32>::from_frontier(cs.final_orchard_tree()),
+            &mut orchard,
+        )
+        .unwrap();
+        let mut ironwood = vec![];
+        write_commitment_tree(
+            &CommitmentTree::<orchard::tree::MerkleHashOrchard, 32>::from_frontier(cs.final_ironwood_tree()),
+            &mut ironwood,
+        )
+        .unwrap();
+        let mut hash = cs.block_hash().0.to_vec();
+        hash.reverse();
+        TreeState {
+            network: "main".into(),
+            height: height.into(),
+            hash: hex::encode(hash),
+            time: 0,
+            sapling_tree: hex::encode(sapling),
+            orchard_tree: hex::encode(orchard),
+            ironwood_tree: hex::encode(ironwood),
+        }
+    }
+
+    /// The mock reports `latest` and serves every generated block above the first one, and
+    /// every tree state.
+    fn serve(&self, mock: &MockLwd, latest: u32) {
+        let mut s = mock.0.lock().unwrap();
+        s.latest = latest.into();
+        let first = *self.states.keys().next().unwrap();
+        for (&hh, _) in self.states.range(first + 1..=latest) {
+            s.blocks.insert(hh.into(), self.compact_block(hh).encode_to_vec());
+        }
+        for &hh in self.states.keys() {
+            s.tree_states.insert(hh.into(), self.tree_state(hh).encode_to_vec());
+        }
+    }
+
+    /// A browser-like `Wallet` (mainnet parameters) over a copy of the test wallet's database.
+    fn wallet(&self, mock: &MockLwd) -> W {
+        let mut bytes = vec![];
+        self.st.wallet().encode(&mut bytes).unwrap();
+        let db = MemoryWalletDb::decode_new(&bytes, chain_params_from(self.start), crate::PRUNING_DEPTH).unwrap();
+        Wallet::new(db, mock.clone(), Network::MainNetwork, ConfirmationsPolicy::MIN).unwrap()
+    }
+}
