+//! A lightwalletd stand-in for native tests: a tower service that speaks gRPC (HTTP/2
+//! framing, `grpc-status` trailers) to tonic's client, serving captured mainnet data.
+
+use std::collections::{BTreeMap, HashMap, HashSet};
+use std::convert::Infallible;
+use std::future::Future;
+use std::pin::Pin;
+use std::sync::{Arc, Mutex};
+use std::task::{Context, Poll};
+
+use prost::Message;
+use tonic::codegen::{http, Bytes, Service};
+use zcash_client_backend::proto::compact_formats::CompactBlock;
+use zcash_client_backend::proto::service::{
+    BlockId, BlockRange, GetSubtreeRootsArg, RawTransaction, SendResponse, ShieldedProtocol, SubtreeRoot, TransparentAddressBlockFilter, TxFilter,
+};
+
+/// The data frames (flag 0) of a gRPC-web response body as captured from lightwalletd.
+pub(crate) fn grpcweb_messages(body: &[u8]) -> Vec<Vec<u8>> {
+    let mut out = vec![];
+    let mut i = 0;
+    while i + 5 <= body.len() {
+        let flag = body[i];
+        let len = u32::from_be_bytes(body[i + 1..i + 5].try_into().unwrap()) as usize;
+        if flag == 0 {
+            out.push(body[i + 5..i + 5 + len].to_vec());
+        } else {
+            assert!(body[i + 5..i + 5 + len].starts_with(b"grpc-status: 0"), "capture is not a success");
+        }
+        i += 5 + len;
+    }
+    out
+}
+
+/// Captured mainnet data (`engine/zcash_client_memory/testdata/mainnet-3533400/`, next to this
+/// checkout as in Celari's layout).
+pub(crate) mod mainnet {
+    macro_rules! testdata {
+        ($file:literal) => {
+            include_bytes!(concat!(
+                env!("CARGO_MANIFEST_DIR"),
+                "/../../../engine/zcash_client_memory/testdata/mainnet-3533400/",
+                $file
+            ))
+        };
+    }
+    pub(crate) const BLOCKS: &[u8] = testdata!("blocks-3533400-3533508.grpcweb");
+    pub(crate) const TREESTATES: &[(u32, &[u8])] = &[
+        (3_533_399, testdata!("treestate-3533399.grpcweb")),
+        (3_533_419, testdata!("treestate-3533419.grpcweb")),
+        (3_533_439, testdata!("treestate-3533439.grpcweb")),
+        (3_533_450, testdata!("treestate-3533450.grpcweb")),
+        (3_533_459, testdata!("treestate-3533459.grpcweb")),
+        (3_533_479, testdata!("treestate-3533479.grpcweb")),
+        (3_533_499, testdata!("treestate-3533499.grpcweb")),
+        (3_533_508, testdata!("treestate-3533508.grpcweb")),
+    ];
+    pub(crate) const SUBTREES_SAPLING: &[u8] = testdata!("subtree-roots-sapling.grpcweb");
+    pub(crate) const SUBTREES_ORCHARD: &[u8] = testdata!("subtree-roots-orchard.grpcweb");
+    pub(crate) const SUBTREES_IRONWOOD: &[u8] = testdata!("subtree-roots-ironwood.grpcweb");
+    /// `GetTransaction` responses of two real transactions in these blocks (v6, NU6.3).
+    pub(crate) const TX_IRONWOOD: (&str, &[u8]) = (
+        "4c0f8c16556719aa01a878e57302740f594eb7b7eacb195cd0f68dda0b30f3a4",
+        testdata!("tx-4c0f8c16556719aa01a878e57302740f594eb7b7eacb195cd0f68dda0b30f3a4.grpcweb"),
+    );
+    pub(crate) const TX_SAPLING: (&str, &[u8]) = (
+        "9426056d10c69122f3913ac183ecfc30469978c94dcb27a29c08496db87320ef",
+        testdata!("tx-9426056d10c69122f3913ac183ecfc30469978c94dcb27a29c08496db87320ef.grpcweb"),
+    );
+    pub(crate) const FIRST: u32 = 3_533_400;
+    pub(crate) const LAST: u32 = 3_533_508;
+}
+
+#[derive(Default)]
+pub(crate) struct State {
+    pub(crate) latest: u64,
+    /// Encoded `CompactBlock`s by height.
+    pub(crate) blocks: BTreeMap<u64, Vec<u8>>,
+    /// Encoded `TreeState`s by height.
+    pub(crate) tree_states: BTreeMap<u64, Vec<u8>>,
+    /// Encoded `SubtreeRoot`s per protocol (0 Sapling, 1 Orchard, 2 Ironwood).
+    pub(crate) subtree_roots: HashMap<i32, Vec<Vec<u8>>>,
+    /// `RawTransaction`s by txid (internal byte order).
+    pub(crate) txs: HashMap<Vec<u8>, RawTransaction>,
+    /// Methods that answer with `UNAVAILABLE`.
+    pub(crate) unavailable: HashSet<&'static str>,
+    /// Every call, in order: method name and, where useful, its argument.
+    pub(crate) calls: Vec<String>,
+    /// `SendTransaction` checks the transaction's consensus
+    /// branch against the next block's, as a node's mempool does, and answers like
+    /// lightwalletd does for a node refusal (`SendResponse` with an error code).
+    pub(crate) node_branch_check: bool,
+    /// The tip of the node `SendTransaction` reaches, if it is another backend
+    /// than the one answering `GetLatestBlock` (servers behind one URL a block apart).
+    pub(crate) node_tip: Option<u64>,
+    /// The raw transactions `SendTransaction` received.
+    pub(crate) sent: Vec<Vec<u8>>,
+}
+
+#[derive(Clone, Default)]
+pub(crate) struct MockLwd(pub(crate) Arc<Mutex<State>>);
+
+impl MockLwd {
+    pub(crate) fn new(latest: u32) -> Self {
+        let mock = Self::default();
+        mock.0.lock().unwrap().latest = u64::from(latest);
+        mock
+    }
+
+    /// Serves the captured mainnet blocks, tree states and subtree roots.
+    pub(crate) fn with_mainnet_data(self) -> Self {
+        {
+            let mut s = self.0.lock().unwrap();
+            for m in grpcweb_messages(mainnet::BLOCKS) {
+                let b = CompactBlock::decode(&m[..]).unwrap();
+                s.blocks.insert(b.height, m);
+            }
+            for (h, body) in mainnet::TREESTATES {
+                s.tree_states.insert(u64::from(*h), grpcweb_messages(body).remove(0));
+            }
+            for (p, body) in [(0, mainnet::SUBTREES_SAPLING), (1, mainnet::SUBTREES_ORCHARD), (2, mainnet::SUBTREES_IRONWOOD)] {
+                s.subtree_roots.insert(p, grpcweb_messages(body));
+            }
+            for (txid, body) in [mainnet::TX_IRONWOOD, mainnet::TX_SAPLING] {
+                let raw = RawTransaction::decode(&grpcweb_messages(body)[0][..]).unwrap();
+                s.txs.insert(hex::decode(txid).unwrap(), raw);
+            }
+        }
+        self
+    }
+
+    /// Also serves a tree state at every height of the captured blocks, computed from the one
+    /// before the first block and the blocks' note commitments (checked against every captured
+    /// tree state), so that batches may start anywhere (`pass_budget`'s batch sizes follow the
+    /// blocks' bytes).
+    pub(crate) fn with_all_tree_states(self) -> Self {
+        use zcash_client_backend::proto::service::TreeState;
+        use zcash_primitives::merkle_tree::write_commitment_tree;
+        let first = TreeState::decode(&grpcweb_messages(mainnet::TREESTATES[0].1)[0][..]).unwrap();
+        let mut sapling = first.sapling_tree().unwrap();
+        let mut orchard = first.orchard_tree().unwrap();
+        let mut ironwood = first.ironwood_tree().unwrap();
+        let orchard_node = |b: &[u8]| {
+            Option::<orchard::tree::MerkleHashOrchard>::from(orchard::tree::MerkleHashOrchard::from_bytes(
+                &b.try_into().unwrap(),
+            ))
+            .unwrap()
+        };
+        let mut s = self.0.lock().unwrap();
+        let blocks: Vec<CompactBlock> = s.blocks.values().map(|m| CompactBlock::decode(&m[..]).unwrap()).collect();
+        for b in blocks {
+            for tx in &b.vtx {
+                for out in &tx.outputs {
+                    let node = Option::<sapling::Node>::from(sapling::Node::from_bytes(out.cmu[..].try_into().unwrap())).unwrap();
+                    sapling.append(node).unwrap();
+                }
+                for a in &tx.actions {
+                    orchard.append(orchard_node(&a.cmx)).unwrap();
+                }
+                for a in &tx.ironwood_actions {
+                    ironwood.append(orchard_node(&a.cmx)).unwrap();
+                }
+            }
+            let hex_tree = |write: &dyn Fn(&mut Vec<u8>)| {
+                let mut v = vec![];
+                write(&mut v);
+                hex::encode(v)
+            };
+            let mut hash = b.hash.clone();
+            hash.reverse();
+            let state = TreeState {
+                network: "main".into(),
+                height: b.height,
+                hash: hex::encode(hash),
+                time: b.time,
+                sapling_tree: hex_tree(&|v| write_commitment_tree(&sapling, v).unwrap()),
+                orchard_tree: hex_tree(&|v| write_commitment_tree(&orchard, v).unwrap()),
+                ironwood_tree: hex_tree(&|v| write_commitment_tree(&ironwood, v).unwrap()),
+            };
+            if let Some(captured) = s.tree_states.get(&b.height) {
+                let captured = TreeState::decode(&captured[..]).unwrap();
+                assert_eq!(
+                    (&state.sapling_tree, &state.orchard_tree, &state.ironwood_tree, &state.hash),
+                    (&captured.sapling_tree, &captured.orchard_tree, &captured.ironwood_tree, &captured.hash),
+                    "computed tree state at {} differs from lightwalletd's",
+                    b.height
+                );
+            }
+            s.tree_states.insert(b.height, state.encode_to_vec());
+        }
+        drop(s);
+        self
+    }
+
+    pub(crate) fn calls(&self) -> Vec<String> {
+        self.0.lock().unwrap().calls.clone()
+    }
+
+    pub(crate) fn count(&self, method: &str) -> usize {
+        self.calls().iter().filter(|c| c.split(' ').next() == Some(method)).count()
+    }
+}
+
+/// A gRPC response body: the messages, then the trailers.
+pub(crate) struct MockBody {
+    data: Option<Bytes>,
+    trailers: Option<http::HeaderMap>,
+}
+
+impl http_body::Body for MockBody {
+    type Data = Bytes;
+    type Error = Infallible;
+
+    fn poll_frame(
+        mut self: Pin<&mut Self>,
+        _cx: &mut Context<'_>,
+    ) -> Poll<Option<Result<http_body::Frame<Bytes>, Infallible>>> {
+        // In chunks of at most 4 KiB, as a network delivers a long answer.
+        if let Some(data) = self.data.as_mut() {
+            let chunk = data.split_to(data.len().min(4096));
+            if data.is_empty() {
+                self.data = None;
+            }
+            return Poll::Ready(Some(Ok(http_body::Frame::data(chunk))));
+        }
+        if let Some(trailers) = self.trailers.take() {
+            return Poll::Ready(Some(Ok(http_body::Frame::trailers(trailers))));
+        }
+        Poll::Ready(None)
+    }
+}
+
+fn response(messages: Vec<Vec<u8>>, status: u32, message: &str) -> http::Response<MockBody> {
+    let mut data = vec![];
+    for m in messages {
+        data.push(0u8);
+        data.extend_from_slice(&(m.len() as u32).to_be_bytes());
+        data.extend_from_slice(&m);
+    }
+    let mut trailers = http::HeaderMap::new();
+    trailers.insert("grpc-status", status.to_string().parse().unwrap());
+    if !message.is_empty() {
+        trailers.insert("grpc-message", message.parse().unwrap());
+    }
+    http::Response::builder()
+        .status(200)
+        .header("content-type", "application/grpc")
+        .body(MockBody { data: (!data.is_empty()).then(|| Bytes::from(data)), trailers: Some(trailers) })
+        .unwrap()
+}
+
+const NOT_FOUND: u32 = 5;
+const UNAVAILABLE: u32 = 14;
+
+async fn read_body(body: tonic::body::Body) -> Vec<u8> {
+    use http_body::Body as _;
+    let mut body = Box::pin(body);
+    let mut out = vec![];
+    while let Some(frame) = std::future::poll_fn(|cx| body.as_mut().poll_frame(cx)).await {
+        if let Ok(data) = frame.expect("request body").into_data() {
+            out.extend_from_slice(&data);
+        }
+    }
+    out
+}
+
+impl Service<http::Request<tonic::body::Body>> for MockLwd {
+    type Response = http::Response<MockBody>;
+    type Error = Infallible;
+    type Future = Pin<Box<dyn Future<Output = Result<Self::Response, Infallible>> + Send>>;
+
+    fn poll_ready(&mut self, _cx: &mut Context<'_>) -> Poll<Result<(), Infallible>> {
+        Poll::Ready(Ok(()))
+    }
+
+    fn call(&mut self, request: http::Request<tonic::body::Body>) -> Self::Future {
+        let state = self.0.clone();
+        let method = request.uri().path().rsplit('/').next().unwrap_or("").to_string();
+        Box::pin(async move {
+            let body = read_body(request.into_body()).await;
+            let msg = if body.len() >= 5 { &body[5..] } else { &body[..] };
+            let mut s = state.lock().unwrap();
+            if s.unavailable.contains(method.as_str()) {
+                s.calls.push(method.clone());
+                return Ok(response(vec![], UNAVAILABLE, "mock: unavailable"));
+            }
+            let r = match method.as_str() {
+                "GetLatestBlock" => {
+                    s.calls.push(method.clone());
+                    response(vec![BlockId { height: s.latest, hash: vec![] }.encode_to_vec()], 0, "")
+                }
+                "GetSubtreeRoots" => {
+                    let arg = GetSubtreeRootsArg::decode(msg).unwrap();
+                    s.calls.push(format!("{method} {:?}", ShieldedProtocol::try_from(arg.shielded_protocol)));
+                    let roots = s.subtree_roots.get(&arg.shielded_protocol).cloned().unwrap_or_default();
+                    let roots = roots.into_iter().skip(arg.start_index as usize);
+                    let roots: Vec<_> = if arg.max_entries > 0 { roots.take(arg.max_entries as usize).collect() } else { roots.collect() };
+                    let _ = SubtreeRoot::default();
+                    response(roots, 0, "")
+                }
+                "GetTreeState" => {
+                    let id = BlockId::decode(msg).unwrap();
+                    s.calls.push(format!("{method} {}", id.height));
+                    match s.tree_states.get(&id.height) {
+                        Some(t) => response(vec![t.clone()], 0, ""),
+                        None => response(vec![], NOT_FOUND, &format!("mock: no tree state at {}", id.height)),
+                    }
+                }
+                "GetBlockRange" => {
+                    let range = BlockRange::decode(msg).unwrap();
+                    let (start, end) = (range.start.unwrap().height, range.end.unwrap().height);
+                    s.calls.push(format!("{method} {start}..={end}"));
+                    let blocks: Vec<_> = s.blocks.range(start..=end).map(|(_, b)| b.clone()).collect();
+                    if blocks.len() as u64 != end - start + 1 {
+                        response(vec![], NOT_FOUND, "mock: blocks missing")
+                    } else {
+                        response(blocks, 0, "")
+                    }
+                }
+                "GetTransaction" => {
+                    let filter = TxFilter::decode(msg).unwrap();
+                    s.calls.push(format!("{method} {}", hex::encode(&filter.hash)));
+                    match s.txs.get(&filter.hash) {
+                        Some(tx) => response(vec![tx.encode_to_vec()], 0, ""),
+                        None => response(
+                            vec![],
+                            NOT_FOUND,
+                            "GetTransaction: getrawtransaction failed: -5: Transaction not found in mempool or best chain",
+                        ),
+                    }
+                }
+                "GetTaddressTxids" => {
+                    let f = TransparentAddressBlockFilter::decode(msg).unwrap();
+                    let r = f.range.unwrap_or_default();
+                    s.calls.push(format!(
+                        "{method} {} {}..={}",
+                        f.address,
+                        r.start.map(|b| b.height).unwrap_or(0),
+                        r.end.map(|b| b.height).unwrap_or(0)
+                    ));
+                    response(vec![], 0, "")
+                }
+                "GetAddressUtxosStream" => {
+                    s.calls.push(method.clone());
+                    response(vec![], 0, "")
+                }
+                "SendTransaction" => {
+                    s.calls.push(method.clone());
+                    let raw = RawTransaction::decode(msg).unwrap();
+                    s.sent.push(raw.data.clone());
+                    let node_tip = s.node_tip.unwrap_or(s.latest);
+                    let refusal = if s.node_branch_check {
+                        use zcash_protocol::consensus::{BlockHeight, BranchId, MAIN_NETWORK};
+                        let tx = zcash_primitives::transaction::Transaction::read(&raw.data[..], BranchId::Nu7).unwrap();
+                        let next = BranchId::for_height(&MAIN_NETWORK, BlockHeight::from_u32(node_tip as u32 + 1));
+                        (tx.consensus_branch_id() != next).then(|| {
+                            format!("mock node at {node_tip}: transaction branch {:?}, next block's {:?}", tx.consensus_branch_id(), next)
+                        })
+                    } else {
+                        None
+                    };
+                    match refusal {
+                        Some(m) => response(vec![SendResponse { error_code: -26, error_message: m }.encode_to_vec()], 0, ""),
+                        None => response(vec![SendResponse { error_code: 0, error_message: String::new() }.encode_to_vec()], 0, ""),
+                    }
+                }
+                other => {
+                    s.calls.push(other.to_string());
+                    response(vec![], 12, "mock: unimplemented")
+                }
+            };
+            Ok(r)
+        })
+    }
+}
