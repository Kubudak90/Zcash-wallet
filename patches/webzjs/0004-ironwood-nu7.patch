+/// Checks that `pczt` can still be mined in the block after `network_tip`
+/// (`boundary::check_minable`: consensus branch, expiry, upgrade pause), and only then extracts
+/// the transaction and stores it in the wallet (which marks its inputs spent and puts it in
+/// the history), ready to broadcast. Nothing is stored for a PCZT that cannot be mined
+/// (review finding R1).
+pub fn extract_and_store_minable_pczt<P, DbT>(
+    params: &P,
+    db: &mut DbT,
+    pczt: Pczt,
+    network_tip: BlockHeight,
+) -> Result<TxId, Error>
+where
+    P: Parameters,
+    DbT: WalletWrite + WalletCommitmentTrees,
+    <DbT as WalletRead>::AccountId: DeserializeOwned,
+    <DbT as WalletRead>::Error: Debug,
+    <DbT as WalletCommitmentTrees>::Error: Debug,
+{
+    boundary::check_minable(
+        params,
+        *pczt.global().consensus_branch_id(),
+        *pczt.global().expiry_height(),
+        network_tip,
+    )?;
+    let prover = LocalTxProver::bundled();
+    let (spend_vk, output_vk) = prover.verifying_keys();
+    let mut rng = secure_rng()?;
+    extract_and_store_transaction_from_pczt::<_, ()>(
+        db,
+        &WebClock,
+        &mut rng,
+        pczt,
+        Some((&spend_vk, &output_vk)),
+        // `None`: the extractor builds the verifying key of the circuit version each
+        // Orchard-protocol bundle (Orchard, Ironwood) was made under.
+        None,
+    )
+    .map_err(|e| Error::PcztSend(format!("Failed to extract and store transaction from PCZT: {:?}", e)))
+}
+
+/// The request for an address with every shielded receiver the key has (Orchard, which
+/// Ironwood shares, and Sapling) and no transparent receiver.
+pub fn shielded_only_request(uivk: &UnifiedIncomingViewingKey) -> Result<UnifiedAddressRequest, Error> {
+    let req = |has: bool| if has { ReceiverRequirement::Require } else { ReceiverRequirement::Omit };
+    UnifiedAddressRequest::custom(
+        req(uivk.orchard().is_some()),
+        req(uivk.sapling().is_some()),
+        ReceiverRequirement::Omit,
+    )
+    .map_err(|_| Error::Generic("this account has no shielded key".to_string()))
+}
+
+/// Transparent value of an account that is not yet spendable: received at too few
+/// confirmations (`AccountBalance.unshielded_pending` in the bindings, review finding R7).
+/// `AccountBalance::change_pending_confirmation` and `value_pending_spendability` cover the
+/// shielded pools only.
+pub fn unshielded_pending(balance: &zcash_client_backend::data_api::AccountBalance) -> u64 {
+    let t = balance.unshielded_balance();
+    u64::from(t.change_pending_confirmation()) + u64::from(t.value_pending_spendability())
+}
